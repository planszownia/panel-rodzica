add_action('admin_init', 'kms_create_database_tables');

function kms_create_database_tables() {

    global $wpdb;

    $charset_collate = $wpdb->get_charset_collate();

    $children_table = $wpdb->prefix . 'kms_children';
    $payments_table = $wpdb->prefix . 'kms_payments';

    $version = get_option('kms_database_version', '0');

    if (version_compare($version, '2.0', '>=')) {
        return;
    }

    require_once ABSPATH . 'wp-admin/includes/upgrade.php';


    /*
     * ==============================
     * TABELA DZIECI
     * ==============================
     */

    $sql_children = "CREATE TABLE {$children_table} (

        id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,

        club_number VARCHAR(30) NOT NULL,

        parent_user_id BIGINT UNSIGNED NULL,

        parent_email VARCHAR(190) NOT NULL,

        child_first_name VARCHAR(100) NOT NULL,

        child_last_name VARCHAR(100) NOT NULL,

        membership_start DATETIME NULL,

        membership_end DATETIME NULL,

        membership_status VARCHAR(30) NOT NULL DEFAULT 'inactive',

        created_at DATETIME NOT NULL,

        updated_at DATETIME NOT NULL,

        PRIMARY KEY (id),

        UNIQUE KEY club_number (club_number),

        KEY parent_user_id (parent_user_id),

        KEY parent_email (parent_email),

        KEY membership_status (membership_status),

        KEY membership_end (membership_end)

    ) {$charset_collate};";


    /*
     * ==============================
     * TABELA PŁATNOŚCI
     * ==============================
     */

    $sql_payments = "CREATE TABLE {$payments_table} (

        id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,

        payment_id VARCHAR(190) NOT NULL,

        tpay_transaction_id VARCHAR(190) NULL,

        tpay_transaction_title VARCHAR(190) NULL,

        child_id BIGINT UNSIGNED NULL,

        club_number VARCHAR(30) NULL,

        parent_user_id BIGINT UNSIGNED NULL,

        parent_email VARCHAR(190) NOT NULL,

        amount DECIMAL(10,2) NOT NULL DEFAULT 0.00,

        period VARCHAR(30) NOT NULL,

        months INT UNSIGNED NOT NULL DEFAULT 0,

        payment_status VARCHAR(30) NOT NULL DEFAULT 'pending',

        payment_date DATETIME NULL,

        source VARCHAR(30) NOT NULL DEFAULT 'parent_panel',

        created_at DATETIME NOT NULL,

        PRIMARY KEY (id),

        UNIQUE KEY payment_id (payment_id),

        UNIQUE KEY tpay_transaction_id (tpay_transaction_id),

        KEY child_id (child_id),

        KEY club_number (club_number),

        KEY parent_user_id (parent_user_id),

        KEY parent_email (parent_email),

        KEY payment_status (payment_status)

    ) {$charset_collate};";


    dbDelta($sql_children);

    dbDelta($sql_payments);


    update_option(
        'kms_database_version',
        '2.0'
    );

}
