        );

        $child =
            $wpdb->get_row(
                $wpdb->prepare(
                    "SELECT *
                     FROM {$children_table}
                     WHERE id = %d
                     LIMIT 1",
                    $new_child_id
                )
            );
    }

    $name =
        trim(
            $child->child_first_name .
            ' ' .
            $child->child_last_name
        );

    $source =
        'public_form';
}


/*
 * =====================================================
 * BLOKADA PODWÓJNEGO KLIKU
 * =====================================================
 */

$lock_key =
    'kms_tpay_payment_lock_' .
    md5(
        strtolower(
            $email .
            '|' .
            $child->id .
            '|' .
            $period
        )
    );

if (get_transient($lock_key)) {

    wp_safe_redirect(
        add_query_arg(
            'kms_tpay_error',
            '1',
            $return_url
        )
    );

    exit;
}

set_transient(
    $lock_key,
    '1',
    30
);


/*
 * =====================================================
 * REKORD PŁATNOŚCI
 * =====================================================
 */

$payment_id =
    'KMSPAY-' .
    time() .
    '-' .
    wp_rand(
        1000,
        9999
    );

$now =
    current_time(
        'mysql'
    );

$inserted =
    $wpdb->insert(

        $payments_table,

        array(

            'payment_id' =>
                $payment_id,

            'tpay_transaction_id' =>
                null,

            'tpay_transaction_title' =>
                null,

            'child_id' =>
                $child->id,

            'club_number' =>
                $child->club_number,

            'parent_user_id' =>
                is_user_logged_in()
                    ? get_current_user_id()
                    : null,

            'parent_email' =>
                $email,

            'amount' =>
                $amount,

            'period' =>
                $period,

            'months' =>
                $months,

            'payment_status' =>
                'pending',

            'payment_date' =>
                null,

            'source' =>
                $source,

            'created_at' =>
                $now
        ),

        array(

            '%s',
            '%s',
            '%s',
            '%d',
            '%s',
            '%d',
            '%s',
            '%f',
            '%s',
            '%d',
            '%s',
            '%s',
            '%s'
        )
    );

if (!$inserted) {

    delete_transient(
        $lock_key
    );

    wp_safe_redirect(
        add_query_arg(
            'kms_tpay_error',
            '1',
            $return_url
        )
    );

    exit;
}

$payment_row_id =
    $wpdb->insert_id;


/*
 * =====================================================
 * TWORZYMY TRANSAKCJĘ TPAY
 * =====================================================
 */

$transaction =
    kms_tpay_create_transaction(

        $payment_id,

        $amount,

        'Klub Małego Stratega – ' .
        ucfirst($period),

        $email,

        $name,

        $return_url
    );

if (is_wp_error($transaction)) {

    $wpdb->update(

        $payments_table,

        array(
            'payment_status' =>
                'failed'
        ),

        array(
            'id' =>
                $payment_row_id
        ),

        array('%s'),
        array('%d')
    );

    delete_transient(
        $lock_key
    );

    wp_safe_redirect(
        add_query_arg(
            'kms_tpay_error',
            '1',
            $return_url
        )
    );

    exit;
}


/*
 * =====================================================
 * ZAPIS TRANSAKCJI TPAY
 * =====================================================
 */

$wpdb->update(

    $payments_table,

    array(

        'tpay_transaction_id' =>
            isset($transaction['transactionId'])
                ? sanitize_text_field(
                    $transaction['transactionId']
                )
                : '',

        'tpay_transaction_title' =>
            isset($transaction['title'])
                ? sanitize_text_field(
                    $transaction['title']
                )
                : ''
    ),

    array(
        'id' =>
            $payment_row_id
    ),

    array(
        '%s',
        '%s'
    ),

    array(
        '%d'
    )
);


/*
 * =====================================================
 * ADRES PŁATNOŚCI
 * =====================================================
 */

$payment_url =
    isset(
        $transaction['transactionPaymentUrl']
    )
        ? esc_url_raw(
            $transaction['transactionPaymentUrl']
        )
        : '';

$payment_host =
    wp_parse_url(
        $payment_url,
        PHP_URL_HOST
    );

if (
    empty($payment_url) ||
    $payment_host !== 'secure.tpay.com'
) {

    delete_transient(
        $lock_key
    );

    wp_safe_redirect(
        add_query_arg(
            'kms_tpay_error',
            '1',
            $return_url
        )
    );

    exit;
}


/*
 * =====================================================
 * PRZEKIEROWANIE DO TPAY
 * =====================================================
 */

wp_redirect(
    $payment_url
);

exit;

}

/*

=========================================================
BASE64URL
=========================================================
*/

function kms_tpay_base64url_decode($value) {

$value =
    strtr(
        $value,
        '-_',
        '+/'
    );

$padding =
    strlen($value) % 4;

if ($padding) {

    $value .=
        str_repeat(
            '=',
            4 - $padding
        );
}

return base64_decode(
    $value,
    true
);

}

function kms_tpay_base64url_encode($value) {

return rtrim(
    strtr(
        base64_encode($value),
        '+/',
        '-_'
    ),
    '='
);

}

/*

=========================================================
CERTYFIKAT ROOT TPAY
=========================================================
*/

function kms_tpay_get_root_certificate() {

$cached =
    get_transient(
        'kms_tpay_root_certificate'
    );

if (!empty($cached)) {
    return $cached;
}

$response =
    wp_remote_get(
        'https://secure.tpay.com/x509/tpay-jws-root.pem',
        array(
            'timeout' => 15
        )
    );

if (is_wp_error($response)) {

    return new WP_Error(
        'kms_tpay_root_error',
        'Nie można pobrać certyfikatu root Tpay.'
    );
}

$http_code =
    wp_remote_retrieve_response_code(
        $response
    );

$certificate =
    wp_remote_retrieve_body(
        $response
    );

if (
    $http_code !== 200 ||
    empty($certificate)
) {

    return new WP_Error(
        'kms_tpay_root_empty',
        'Tpay nie zwrócił certyfikatu root.'
    );
}

set_transient(
    'kms_tpay_root_certificate',
    $certificate,
    DAY_IN_SECONDS
);

return $certificate;

}

/*

=========================================================
CERTYFIKAT PODPISU TPAY
=========================================================
*/

function kms_tpay_get_notification_certificate(
$x5u
) {

$parsed =
    wp_parse_url(
        $x5u
    );

if (
    empty($parsed['scheme']) ||
    strtolower($parsed['scheme']) !== 'https' ||
    empty($parsed['host']) ||
    strtolower($parsed['host']) !== 'secure.tpay.com'
) {

    return new WP_Error(
        'kms_tpay_invalid_x5u',
        'Nieprawidłowy adres certyfikatu JWS Tpay.'
    );
}

$cache_key =
    'kms_tpay_notification_certificate_' .
    md5($x5u);

$cached =
    get_transient(
        $cache_key
    );

if (!empty($cached)) {
    return $cached;
}

$response =
    wp_remote_get(
        esc_url_raw($x5u),
        array(
            'timeout' => 15
        )
    );

if (is_wp_error($response)) {

    return new WP_Error(
        'kms_tpay_certificate_error',
        'Nie można pobrać certyfikatu JWS Tpay.'
    );
}

$http_code =
    wp_remote_retrieve_response_code(
        $response
    );

$certificate =
    wp_remote_retrieve_body(
        $response
    );

if (
    $http_code !== 200 ||
    empty($certificate)
) {

    return new WP_Error(
        'kms_tpay_certificate_empty',
        'Tpay nie zwrócił certyfikatu JWS.'
    );
}

set_transient(
    $cache_key,
    $certificate,
    DAY_IN_SECONDS
);

return $certificate;

}

/*

=========================================================
WERYFIKACJA JWS TPAY
=========================================================
*/

function kms_tpay_verify_jws(
$jws,
$body
) {

if (empty($jws)) {

    return new WP_Error(
        'kms_tpay_missing_jws',
        'Brak nagłówka X-JWS-Signature.'
    );
}

$parts =
    explode(
        '.',
        $jws
    );

if (count($parts) !== 3) {

    return new WP_Error(
        'kms_tpay_invalid_jws',
        'Nieprawidłowa struktura podpisu JWS.'
    );
}

$header_part =
    $parts[0];

$signature_part =
    $parts[2];

$header_json =
    kms_tpay_base64url_decode(
        $header_part
    );

$signature =
    kms_tpay_base64url_decode(
        $signature_part
    );

if (
    false === $header_json ||
    false === $signature
) {

    return new WP_Error(
        'kms_tpay_invalid_jws_encoding',
        'Nieprawidłowe kodowanie podpisu JWS.'
    );
}

$header_data =
    json_decode(
        $header_json,
        true
    );

if (!is_array($header_data)) {

    return new WP_Error(
        'kms_tpay_invalid_jws_header',
        'Nieprawidłowy nagłówek JWS.'
    );
}

/*
 * Tpay używa RS256.
 */

if (
    empty($header_data['alg']) ||
    strtoupper(
        $header_data['alg']
    ) !== 'RS256'
) {

    return new WP_Error(
        'kms_tpay_invalid_jws_algorithm',
        'Nieprawidłowy algorytm podpisu Tpay.'
    );
}

/*
 * Tpay przekazuje adres certyfikatu
 * w polu x5u.
 */

if (empty($header_data['x5u'])) {

    return new WP_Error(
        'kms_tpay_missing_x5u',
        'Brak adresu certyfikatu x5u w podpisie Tpay.'
    );
}

$x5u =
    esc_url_raw(
        $header_data['x5u']
    );

$certificate =
    kms_tpay_get_notification_certificate(
        $x5u
    );

if (is_wp_error($certificate)) {
    return $certificate;
}

$root_certificate =
    kms_tpay_get_root_certificate();

if (is_wp_error($root_certificate)) {
    return $root_certificate;
}

if (
    !function_exists(
        'openssl_verify'
    )
) {

    return new WP_Error(
        'kms_tpay_openssl_missing',
        'Brak OpenSSL na serwerze.'
    );
}

/*
 * Sprawdzamy, czy certyfikat podpisujący
 * został wystawiony przez Tpay CA.
 */

if (
    function_exists(
        'openssl_x509_verify'
    )
) {

    $certificate_verified =
        openssl_x509_verify(
            $certificate,
            $root_certificate
        );

    if (
        1 !==
        $certificate_verified
    ) {

        return new WP_Error(
            'kms_tpay_invalid_certificate',
            'Certyfikat podpisujący Tpay nie przeszedł weryfikacji.'
        );
    }
}

$public_key =
    openssl_pkey_get_public(
        $certificate
    );

if (!$public_key) {

    return new WP_Error(
        'kms_tpay_public_key_error',
        'Nie można odczytać klucza publicznego Tpay.'
    );
}

/*
 * Tpay wymaga weryfikacji:
 *
 * JWS header + "." + base64url(body)
 */

$payload =
    kms_tpay_base64url_encode(
        $body
    );

$signing_input =
    $header_part .
    '.' .
    $payload;

$verified =
    openssl_verify(
        $signing_input,
        $signature,
        $public_key,
        OPENSSL_ALGO_SHA256
    );

if (1 !== $verified) {

    return new WP_Error(
        'kms_tpay_invalid_signature',
        'Nieprawidłowy podpis JWS Tpay.'
    );
}

return true;

}

