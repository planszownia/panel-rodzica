/*

=========================================================
WEBHOOK TPAY
=========================================================
*/

function kms_tpay_notification(
WP_REST_Request $request
) {

global $wpdb;

/*
 * Podpis JWS.
 */

$jws =
    $request->get_header(
        'X-JWS-Signature'
    );

/*
 * Surowe body.
 *
 * NIE zmieniamy go przed weryfikacją.
 */

$body =
    $request->get_body();


/*
 * =====================================================
 * 1. JWS
 * =====================================================
 */

$verified =
    kms_tpay_verify_jws(
        $jws,
        $body
    );

if (is_wp_error($verified)) {

    return new WP_REST_Response(
        $verified->get_error_message(),
        400
    );
}


/*
 * =====================================================
 * 2. PARAMETRY TPAY
 * =====================================================
 */

$data =
    array();

parse_str(
    $body,
    $data
);


$required = array(

    'id',
    'tr_id',
    'tr_amount',
    'tr_paid',
    'tr_crc',
    'tr_status',
    'tr_email',
    'md5sum'
);

foreach ($required as $field) {

    if (
        !isset(
            $data[$field]
        )
    ) {

        return new WP_REST_Response(
            'Brak parametru: ' . $field,
            400
        );
    }
}


/*
 * =====================================================
 * 3. STATUS
 * =====================================================
 */

$status =
    strtolower(
        trim(
            (string)
            $data['tr_status']
        )
    );

if ($status !== 'true') {

    /*
     * chargeback nie jest nową płatnością.
     */

    return new WP_REST_Response(
        'Nieprawidłowy status płatności.',
        400
    );
}


/*
 * =====================================================
 * 4. KOD BEZPIECZEŃSTWA
 * =====================================================
 *
 * Jeżeli kod nie jest ustawiony w Tpay,
 * wartość jest pustym ciągiem.
 */

$security_code =
    get_option(
        'kms_tpay_security_code',
        ''
    );


/*
 * =====================================================
 * 5. MD5
 * =====================================================
 *
 * Tpay:
 *
 * md5(
 *   id .
 *   tr_id .
 *   tr_amount .
 *   tr_crc .
 *   code
 * )
 */

$expected_md5 =
    md5(
        $data['id'] .
        $data['tr_id'] .
        $data['tr_amount'] .
        $data['tr_crc'] .
        $security_code
    );

$received_md5 =
    strtolower(
        trim(
            (string)
            $data['md5sum']
        )
    );

if (
    !hash_equals(
        strtolower(
            $expected_md5
        ),
        $received_md5
    )
) {

    return new WP_REST_Response(
        'Nieprawidłowa suma kontrolna Tpay.',
        400
    );
}


/*
 * =====================================================
 * 6. NASZE ID PŁATNOŚCI
 * =====================================================
 *
 * tr_crc = hiddenDescription
 */

$payment_id =
    sanitize_text_field(
        $data['tr_crc']
    );

$payments_table =
    $wpdb->prefix .
    'kms_payments';

$children_table =
    $wpdb->prefix .
    'kms_children';


/*
 * =====================================================
 * 7. SZUKAMY PŁATNOŚCI
 * =====================================================
 */

$payment =
    $wpdb->get_row(
        $wpdb->prepare(
            "SELECT *
             FROM {$payments_table}
             WHERE payment_id = %s
             LIMIT 1",
            $payment_id
        )
    );

if (!$payment) {

    return new WP_REST_Response(
        'Nie znaleziono płatności.',
        404
    );
}


/*
 * =====================================================
 * 8. IDEMPOTENCJA
 * =====================================================
 */

if (
    $payment->payment_status ===
    'paid'
) {

    return new WP_REST_Response(
        'TRUE',
        200
    );
}


/*
 * =====================================================
 * 9. KWOTA
 * =====================================================
 */

$expected_amount =
    (float)
    $payment->amount;

$paid_amount =
    (float)
    $data['tr_paid'];

if (
    abs(
        $expected_amount -
        $paid_amount
    ) > 0.001
) {

    return new WP_REST_Response(
        'Nieprawidłowa kwota płatności.',
        400
    );
}


/*
 * =====================================================
 * 10. WALUTA
 * =====================================================
 */

if (
    isset(
        $data['tr_currency']
    ) &&
    !empty(
        $data['tr_currency']
    ) &&
    strtoupper(
        $data['tr_currency']
    ) !== 'PLN'
) {

    return new WP_REST_Response(
        'Nieprawidłowa waluta.',
        400
    );
}


/*
 * =====================================================
 * 11. DZIECKO
 * =====================================================
 */

$child =
    $wpdb->get_row(
        $wpdb->prepare(
            "SELECT *
             FROM {$children_table}
             WHERE id = %d
             LIMIT 1",
            $payment->child_id
        )
    );

if (!$child) {

    return new WP_REST_Response(
        'Nie znaleziono dziecka.',
        400
    );
}


/*
 * =====================================================
 * 12. DATY
 * =====================================================
 */

$now_timestamp =
    current_time(
        'timestamp'
    );

$now_mysql =
    current_time(
        'mysql'
    );

$start_timestamp =
    $now_timestamp;


/*
 * Jeżeli członkostwo jest nadal aktywne,
 * przedłużamy od obecnej daty końca.
 */

if (
    $child->membership_status ===
    'active' &&
    !empty(
        $child->membership_end
    )
) {

    $existing_end =
        strtotime(
            $child->membership_end
        );

    if (
        $existing_end &&
        $existing_end >
        $now_timestamp
    ) {

        $start_timestamp =
            $existing_end;
    }
}


$start_date =
    new DateTime(
        '@' .
        $start_timestamp
    );

$start_date->setTimezone(
    wp_timezone()
);

$end_date =
    clone $start_date;

$end_date->modify(
    '+' .
    intval(
        $payment->months
    ) .
    ' months'
);

$membership_start =
    wp_date(
        'Y-m-d H:i:s',
        $start_date->getTimestamp()
    );

$membership_end =
    wp_date(
        'Y-m-d H:i:s',
        $end_date->getTimestamp()
    );


/*
 * =====================================================
 * 13. AKTYWUJEMY CZŁONKOSTWO
 * =====================================================
 */

$updated_child =
    $wpdb->update(

        $children_table,

        array(

            'membership_start' =>
                $membership_start,

            'membership_end' =>
                $membership_end,

            'membership_status' =>
                'active',

            'updated_at' =>
                $now_mysql
        ),

        array(

            'id' =>
                $child->id
        ),

        array(

            '%s',
            '%s',
            '%s',
            '%s'
        ),

        array(
            '%d'
        )
    );

if (false === $updated_child) {

    return new WP_REST_Response(
        'Nie udało się aktywować członkostwa.',
        500
    );
}


/*
 * =====================================================
 * 14. OZNACZAMY PŁATNOŚĆ
 * =====================================================
 */

$updated_payment =
    $wpdb->update(

        $payments_table,

        array(

            'payment_status' =>
                'paid',

            'payment_date' =>
                $now_mysql
        ),

        array(

            'id' =>
                $payment->id
        ),

        array(

            '%s',
            '%s'
        ),

        array(
            '%d'
        )
    );

if (false === $updated_payment) {

    return new WP_REST_Response(
        'Nie udało się zapisać statusu płatności.',
        500
    );
}


/*
 * =====================================================
 * 15. SUKCES
 * =====================================================
 */

return new WP_REST_Response(
    'TRUE',
    200
);

}

