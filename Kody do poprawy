        );


    $duration_type =
        isset($_POST['kms_remove_duration_type'])
            ? sanitize_text_field(
                wp_unslash(
                    $_POST['kms_remove_duration_type']
                )
            )
            : 'month';


    $duration_value =
        isset($_POST['kms_remove_duration_value'])
            ? intval(
                $_POST['kms_remove_duration_value']
            )
            : 1;


    if ($duration_value < 1) {
        $duration_value = 1;
    }


    /*
     * Pobieramy dziecko.
     */

    $child =
        $wpdb->get_row(
            $wpdb->prepare(
                "SELECT *
                 FROM {$table}
                 WHERE id = %d",
                $child_id
            )
        );


    if ($child) {

        /*
         * Jeżeli nie ma daty końcowej,
         * nie ma czego odejmować.
         */

        if (empty($child->membership_end)) {

            echo '
            <div class="notice notice-error is-dismissible">
                <p>
                    <strong>
                        To dziecko nie ma ustawionej daty końca członkostwa.
                    </strong>
                </p>
            </div>
            ';

        } else {

            $timezone =
                wp_timezone();


            $today =
                current_time('Y-m-d');


            $date =
                new DateTime(
                    $child->membership_end,
                    $timezone
                );


            /*
             * Odejmujemy wybraną liczbę
             * miesięcy lub dni.
             */

            if ($duration_type === 'month') {

                $date->modify(
                    '-' . $duration_value . ' month'
                );

            } elseif ($duration_type === 'day') {

                $date->modify(
                    '-' . $duration_value . ' day'
                );

            }


            $end_date =
                $date->format('Y-m-d');


            /*
             * Jeżeli nowa data końca jest
             * wcześniejsza niż dzisiaj,
             * członkostwo staje się nieaktywne.
             *
             * Jeżeli data jest dzisiaj lub później,
             * pozostaje aktywne.
             */

            if ($end_date < $today) {

                $membership_status =
                    'inactive';

            } else {

                $membership_status =
                    'active';

            }


            $wpdb->update(

                $table,

                array(

                    'membership_end' =>
                        $end_date,

                    'membership_status' =>
                        $membership_status,

                    'updated_at' =>
                        current_time('mysql')

                ),

                array(

                    'id' =>
                        $child_id

                ),

                array(

                    '%s',
                    '%s',
                    '%s'

                ),

                array(

                    '%d'

                )

            );


            if ($membership_status === 'active') {

                echo '
                <div class="notice notice-success is-dismissible">
                    <p>
                        <strong>
                            Członkostwo zostało skrócone.
                        </strong>
                        Nowa data ważności:
                        <strong>
                            ' .
                            esc_html(
                                date_i18n(
                                    'd.m.Y',
                                    strtotime($end_date)
                                )
                            )
                            .
                        '</strong>
                    </p>
                </div>
                ';

            } else {

                echo '
                <div class="notice notice-warning is-dismissible">
                    <p>
                        <strong>
                            Członkostwo zostało skrócone i stało się nieaktywne.
                        </strong>
                        Data ważności:
                        <strong>
                            ' .
                            esc_html(
                                date_i18n(
                                    'd.m.Y',
                                    strtotime($end_date)
                                )
                            )
                            .
                        '</strong>
                    </p>
                </div>
                ';
            }
        }

    } else {

        echo '
        <div class="notice notice-error is-dismissible">
            <p>
                Nie znaleziono dziecka.
            </p>
        </div>
        ';
    }
}


