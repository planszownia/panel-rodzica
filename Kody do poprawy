function kms_add_child_shortcode() {

if (!is_user_logged_in()) {

    return '
        <div class="kms-login-message">
            Musisz być zalogowany, aby dodać dziecko.
        </div>
    ';

}

global $wpdb;

$user = wp_get_current_user();

$table = $wpdb->prefix . 'kms_children';

$message = '';


/*
 * ZAPIS NOWEGO DZIECKA
 */

if (
    isset($_POST['kms_add_child_submit'])
    &&
    isset($_POST['kms_add_child_nonce'])
    &&
    wp_verify_nonce(
        sanitize_text_field(
            wp_unslash(
                $_POST['kms_add_child_nonce']
            )
        ),
        'kms_add_child_action'
    )
) {

    $first_name = isset($_POST['kms_child_first_name'])
        ? sanitize_text_field(
            wp_unslash(
                $_POST['kms_child_first_name']
            )
        )
        : '';

    $last_name = isset($_POST['kms_child_last_name'])
        ? sanitize_text_field(
            wp_unslash(
                $_POST['kms_child_last_name']
            )
        )
        : '';


    /*
     * Sprawdzamy dane.
     */

    if (
        empty($first_name)
        ||
        empty($last_name)
    ) {

        $message = '
            <div class="kms-error">
                Wpisz imię i nazwisko dziecka.
            </div>
        ';

    } else {


        /*
         * Zabezpieczenie przed przypadkowym
         * wielokrotnym wysłaniem tego samego formularza.
         */

        $lock_key =
            'kms_add_child_' .
            $user->ID . '_' .
            md5(
                strtolower(
                    $first_name . '|' . $last_name
                )
            );


        if (
            get_transient($lock_key)
        ) {

            /*
             * Rekord został już przed chwilą dodany.
             */

            wp_safe_redirect(
                add_query_arg(
                    'kms_child_added',
                    '1',
                    wp_get_referer()
                        ? wp_get_referer()
                        : home_url('/')
                )
            );

            exit;

        }


        /*
         * Blokada na 30 sekund.
         */

        set_transient(
            $lock_key,
            '1',
            30
        );


        /*
         * Pobieramy ostatni numer ID.
         */

        $last_id =
            $wpdb->get_var(
                "SELECT MAX(id)
                 FROM {$table}"
            );


        $next_id =
            intval($last_id) + 1;


        /*
         * Numer Klubowy.
         */

        $club_number =
            'KMS-' .
            str_pad(
                $next_id,
                6,
                '0',
                STR_PAD_LEFT
            );


        /*
         * Aktualny czas.
         */

        $now =
            current_time('mysql');


        /*
         * Zapis dziecka.
         */

        $inserted =
            $wpdb->insert(

                $table,

                array(

                    'club_number' =>
                        $club_number,

                    'parent_user_id' =>
                        $user->ID,

                    'parent_email' =>
                        $user->user_email,

                    'child_first_name' =>
                        $first_name,

                    'child_last_name' =>
                        $last_name,

                    'membership_start' =>
                        null,

                    'membership_end' =>
                        null,

                    'membership_status' =>
                        'inactive',

                    'created_at' =>
                        $now,

                    'updated_at' =>
                        $now

                ),

                array(

                    '%s',
                    '%d',
                    '%s',
                    '%s',
                    '%s',
                    '%s',
                    '%s',
                    '%s',
                    '%s',
                    '%s'

                )

            );


        if ($inserted) {

            /*
             * PRZEKIEROWANIE PO ZAPISIE
             *
             * Dzięki temu odświeżenie strony
             * nie wyśle ponownie formularza.
             */

            $redirect_url =
                wp_get_referer()
                    ? wp_get_referer()
                    : home_url('/');


            $redirect_url =
                add_query_arg(
                    array(
                        'kms_child_added' =>
                            '1',
                        'kms_child_number' =>
                            $club_number
                    ),
                    $redirect_url
                );


            wp_safe_redirect(
                $redirect_url
            );

            exit;

        } else {

            /*
             * Jeżeli zapis się nie udał,
             * usuwamy blokadę.
             */

            delete_transient(
                $lock_key
            );


            $message = '

                <div class="kms-error">

                    Nie udało się zapisać dziecka.
                    Spróbuj ponownie.

                </div>

            ';

        }

    }

}


/*
 * INFORMACJA PO PRAWIDŁOWYM DODANIU
 */

if (
    isset($_GET['kms_child_added'])
    &&
    $_GET['kms_child_added'] === '1'
) {

    $club_number =
        isset($_GET['kms_child_number'])
            ? sanitize_text_field(
                wp_unslash(
                    $_GET['kms_child_number']
                )
            )
            : '';


    $message = '

        <div class="kms-success">

            <strong>
                Dziecko zostało dodane.
            </strong>

            <br><br>

            Numer Klubowy:

            <strong>
                ' .
                esc_html(
                    $club_number
                )
                . '
            </strong>

        </div>

    ';

}


