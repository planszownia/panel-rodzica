*/

function kms_tpay_get_access_token() {

$cached_token = get_transient(
    'kms_tpay_oauth_token'
);

if (!empty($cached_token)) {
    return $cached_token;
}

$client_id = get_option(
    'kms_tpay_client_id',
    ''
);

$client_secret = get_option(
    'kms_tpay_client_secret',
    ''
);

if (
    empty($client_id) ||
    empty($client_secret)
) {

    return new WP_Error(
        'kms_tpay_missing_credentials',
        'Brak Client ID lub Client Secret Tpay.'
    );
}

$response = wp_remote_post(
    'https://api.tpay.com/oauth/auth',
    array(
        'timeout' => 20,
        'headers' => array(
            'Content-Type' =>
                'application/x-www-form-urlencoded'
        ),
        'body' => array(
            'client_id' =>
                $client_id,
            'client_secret' =>
                $client_secret
        )
    )
);

if (is_wp_error($response)) {

    return new WP_Error(
        'kms_tpay_connection_error',
        $response->get_error_message()
    );
}

$http_code = wp_remote_retrieve_response_code(
    $response
);

$body = wp_remote_retrieve_body(
    $response
);

$data = json_decode(
    $body,
    true
);

if (
    $http_code < 200 ||
    $http_code >= 300 ||
    !is_array($data) ||
    empty($data['access_token'])
) {

    return new WP_Error(
        'kms_tpay_oauth_error',
        'Tpay nie zwrócił prawidłowego tokenu OAuth.'
    );
}

$access_token = sanitize_text_field(
    $data['access_token']
);

$expires_in = isset($data['expires_in'])
    ? intval($data['expires_in'])
    : 7200;

$expires_in = max(
    60,
    $expires_in - 60
);

set_transient(
    'kms_tpay_oauth_token',
    $access_token,
    $expires_in
);

return $access_token;

}

