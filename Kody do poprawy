function kms_tpay_create_transaction(
$payment_id,
$amount,
$description,
$payer_email,
$payer_name,
$return_url
) {

$token = kms_tpay_get_access_token();

if (is_wp_error($token)) {
    return $token;
}

$notification_url = rest_url(
    'kms/v1/tpay-notification'
);

$success_url = add_query_arg(
    'kms_tpay',
    'success',
    $return_url
);

$error_url = add_query_arg(
    'kms_tpay',
    'error',
    $return_url
);

$body = array(

    'amount' =>
        round(
            (float) $amount,
            2
        ),

    'currency' =>
        'PLN',

    'description' =>
        $description,

    /*
     * Tpay zwróci tę wartość jako tr_crc.
     */
    'hiddenDescription' =>
        $payment_id,

    'payer' => array(

        'email' =>
            $payer_email,

        'name' =>
            $payer_name
    ),

    'callbacks' => array(

        'notification' => array(

            'url' =>
                $notification_url
        ),

        'payerUrls' => array(

            'success' =>
                $success_url,

            'error' =>
                $error_url
        )
    )
);

$response = wp_remote_post(
    'https://api.tpay.com/transactions',
    array(
        'timeout' => 30,

        'headers' => array(
            'Content-Type' =>
                'application/json',

            'Authorization' =>
                'Bearer ' . $token
        ),

        'body' =>
            wp_json_encode($body)
    )
);

if (is_wp_error($response)) {

    return new WP_Error(
        'kms_tpay_transaction_connection',
        $response->get_error_message()
    );
}

$http_code = wp_remote_retrieve_response_code(
    $response
);

$response_body = wp_remote_retrieve_body(
    $response
);

$data = json_decode(
    $response_body,
    true
);

if (
    $http_code < 200 ||
    $http_code >= 300 ||
    !is_array($data) ||
    empty($data['transactionPaymentUrl'])
) {

    return new WP_Error(
        'kms_tpay_transaction_error',
        'Nie udało się utworzyć płatności Tpay.'
    );
}

return $data;

}

