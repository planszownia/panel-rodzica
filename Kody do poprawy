function kms_children_page() {

if (!current_user_can('manage_options')) {
    return;
}


global $wpdb;

$table =
    $wpdb->prefix . 'kms_children';


/*
 * USUWANIE DZIECKA
 */

if (
    isset($_POST['kms_delete_child'])
    &&
    check_admin_referer(
        'kms_delete_child_action',
        'kms_delete_child_nonce'
    )
) {

    $child_id =
        intval(
            $_POST['kms_delete_child']
        );


    if ($child_id > 0) {

        $wpdb->delete(
            $table,
            array(
                'id' => $child_id
            ),
            array(
                '%d'
            )
        );


        echo '
        <div class="notice notice-success is-dismissible">
            <p>
                <strong>Dziecko zostało usunięte.</strong>
            </p>
        </div>
        ';
    }
}


/*
 * DODANIE DARMOWEGO CZŁONKOSTWA
 */

if (
    isset($_POST['kms_grant_membership'])
    &&
    check_admin_referer(
        'kms_grant_membership_action',
        'kms_grant_membership_nonce'
    )
) {

    $child_id =
        intval(
            $_POST['kms_grant_membership']
        );


    $duration_type =
        isset($_POST['kms_duration_type'])
            ? sanitize_text_field(
                wp_unslash(
                    $_POST['kms_duration_type']
                )
            )
            : 'month';


    $duration_value =
        isset($_POST['kms_duration_value'])
            ? intval(
                $_POST['kms_duration_value']
            )
            : 1;


    if ($duration_value < 1) {
        $duration_value = 1;
    }


    /*
     * Pobieramy dziecko.
     */

    $child =
        $wpdb->get_row(
            $wpdb->prepare(
                "SELECT *
                 FROM {$table}
                 WHERE id = %d",
                $child_id
            )
        );


    if ($child) {

        /*
         * Jeżeli dziecko ma już aktywne
         * członkostwo, przedłużamy je
         * od obecnej daty końca.
         *
         * Jeżeli nie ma aktywnego członkostwa,
         * zaczynamy od dzisiaj.
         */

        $today =
            current_time('Y-m-d');


        $start_date =
            $today;


        if (
            $child->membership_status === 'active'
            &&
            !empty($child->membership_end)
            &&
            $child->membership_end >= $today
        ) {

            $start_date =
                $child->membership_end;

        }


        $timezone =
            wp_timezone();


        $date =
            new DateTime(
                $start_date,
                $timezone
            );


        /*
         * Liczenie okresu.
         */

        if ($duration_type === 'month') {

            $date->modify(
                '+' . $duration_value . ' month'
            );

        } elseif ($duration_type === 'day') {

            $date->modify(
                '+' . $duration_value . ' day'
            );

        }


        $end_date =
            $date->format('Y-m-d');


        /*
         * Jeżeli zaczynamy nowe członkostwo,
         * zapisujemy również datę startu.
         */

        if (
            $child->membership_status !== 'active'
            ||
            empty($child->membership_start)
        ) {

            $membership_start =
                $today;

        } else {

            $membership_start =
                $child->membership_start;

        }


        $wpdb->update(

            $table,

            array(

                'membership_start' =>
                    $membership_start,

                'membership_end' =>
                    $end_date,

                'membership_status' =>
                    'active',

                'updated_at' =>
                    current_time('mysql')

            ),

            array(

                'id' =>
                    $child_id

            ),

            array(

                '%s',
                '%s',
                '%s',
                '%s'

            ),

            array(

                '%d'

            )

        );


        echo '
        <div class="notice notice-success is-dismissible">
            <p>
                <strong>
                    Darmowe członkostwo zostało przyznane.
                </strong>
                Ważne do:
                <strong>
                    ' .
                    esc_html(
                        date_i18n(
                            'd.m.Y',
                            strtotime($end_date)
                        )
                    )
                    .
                '</strong>
            </p>
        </div>
        ';

    } else {

        echo '
        <div class="notice notice-error is-dismissible">
            <p>
                Nie znaleziono dziecka.
            </p>
        </div>
        ';
    }
}


/*
