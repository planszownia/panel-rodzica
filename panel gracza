    private function table_card($r,$uid,$closed=false) {
        global $wpdb;$t=$this->tables();
        $players=$wpdb->get_results($wpdb->prepare("SELECT tp.*,u.display_name FROM {$t['table_players']} tp INNER JOIN {$wpdb->users} u ON u.ID=tp.user_id WHERE tp.table_id=%d ORDER BY tp.id", $r->id));
        $mine=null; foreach($players as $p) if((int)$p->user_id===$uid) $mine=$p;
        $status=$r->status==='voting'?'Głosowanie':($r->status==='active'?'Aktywny stół':'Zamknięta gra');
        ob_start();
        echo '<div class="pw-table-card"><div class="pw-table-top"><div><span class="pw-badge">'.esc_html($status).'</span><h4>'.esc_html($r->title).'</h4></div><span class="pw-table-no">#'.(int)$r->id.'</span></div>';
        echo '<div class="pw-players">'; foreach($players as $p){$cl=$p->winner?' winner':''; echo '<span class="pw-player'.$cl.'">'.esc_html($p->display_name).'</span>';} echo '</div>';
        if($r->status==='voting' && $mine){
            $options=$wpdb->get_results($wpdb->prepare("SELECT o.*,g.title,g.image_url, (SELECT COUNT(*) FROM {$t['table_players']} vp WHERE vp.table_id=o.table_id AND vp.vote_game_id=o.game_id) votes FROM {$t['table_options']} o INNER JOIN {$t['games']} g ON g.id=o.game_id WHERE o.table_id=%d ORDER BY o.position ASC,o.id ASC", $r->id));
            echo '<div class="pw-vote-box"><strong>Wybierz grę:</strong><div class="pw-poll-options">';
            foreach($options as $o){$sel=((int)$mine->vote_game_id===(int)$o->game_id)?' selected':''; $img=$o->image_url?:''; echo '<button type="button" class="pw-poll-option'.$sel.'" data-table="'.(int)$r->id.'" data-game="'.(int)$o->game_id.'"><span class="pw-poll-thumb">'.($img?'<img loading="lazy" src="'.esc_url($img).'" alt="">':'').'</span><span class="pw-poll-name">'.esc_html($o->title).'</span><span class="pw-poll-votes">'.(int)$o->votes.' głos'.(((int)$o->votes===1)?'':'ów').'</span></button>';} 
            echo $this->voting_players_html((int)$r->id);
            echo '</div></div><small class="pw-deadline">Głosowanie do '.esc_html(mysql2date('d.m.Y H:i',$r->vote_deadline)).'</small>';
            if((int)$r->owner_id===$uid){
                echo '<div class="pw-voting-owner-actions"><button type="button" class="pw-btn pw-finish-voting" data-table="'.(int)$r->id.'">Zakończ głosowanie teraz</button><button type="button" class="pw-btn pw-delete-voting" data-table="'.(int)$r->id.'">Usuń głosowanie</button></div>';
            }
        }
        if($r->status==='active' && (int)$r->owner_id===$uid){
            echo '<div class="pw-result-box"><h5>Wynik po grze</h5><p>Zaznacz zwycięzcę lub kilku zwycięzców i wpisz punkty.</p><div class="pw-result-list">';
            foreach($players as $p){
                echo '<label><span>'.esc_html($p->display_name).'</span><input type="number" step="0.01" class="pw-points" data-user="'.(int)$p->user_id.'" placeholder="punkty"><span class="pw-check"><input type="checkbox" class="pw-winner" data-user="'.(int)$p->user_id.'"> zwycięzca</span></label>';
            }
            echo '</div><button type="button" class="pw-btn pw-close-table" data-table="'.(int)$r->id.'">Zapisz wynik i zamknij stół</button></div>';
        }
        if($closed){
            echo '<div class="pw-closed-meta">Wynik zapisany w rankingu. '.esc_html(mysql2date('d.m.Y H:i',$r->closed_at)).'</div>';
            echo '<div class="pw-closed-results">'.$this->closed_results($r->id).'</div>';
            if((int)$r->owner_id===$uid){
                echo '<button type="button" class="pw-btn pw-btn-light pw-edit-result" data-table="'.(int)$r->id.'">✏️ Edytuj wynik</button>';
                echo '<div class="pw-edit-result-box" id="pw-edit-result-'.(int)$r->id.'" style="display:none">';
                echo '<div class="pw-result-list">';
                $saved=$wpdb->get_results($wpdb->prepare("SELECT r.*,u.display_name FROM {$t['results']} r INNER JOIN {$wpdb->users} u ON u.ID=r.user_id WHERE r.table_id=%d ORDER BY r.rank_place ASC,u.display_name ASC",$r->id));
                foreach($saved as $sr){
                    echo '<label><span>'.esc_html($sr->display_name).'</span><input type="number" step="0.01" class="pw-edit-points" data-user="'.(int)$sr->user_id.'" value="'.esc_attr($sr->points).'" placeholder="punkty"><span class="pw-check"><input type="checkbox" class="pw-edit-winner" data-user="'.(int)$sr->user_id.'" '.checked((int)$sr->winner,1,false).'> zwycięzca</span></label>';
                }
                echo '</div><button type="button" class="pw-btn pw-save-result" data-table="'.(int)$r->id.'">Zapisz poprawiony wynik</button><div class="pw-msg pw-edit-msg"></div></div>';
            }
        }
        echo '</div>'; return ob_get_clean();
    }

    private function closed_results($table_id) {
        global $wpdb;$t=$this->tables();
        $rows=$wpdb->get_results($wpdb->prepare("SELECT r.*,u.display_name FROM {$t['results']} r INNER JOIN {$wpdb->users} u ON u.ID=r.user_id WHERE r.table_id=%d ORDER BY r.rank_place ASC,u.display_name ASC",$table_id));
