                $wpdb->update($t['results'],['points'=>$rr['points'],'winner'=>$rr['winner'],'rank_place'=>$place,'ranking_points'=>$rp],['id'=>$rr['id'],'table_id'=>$tid]);
            }
            wp_send_json_success(['message'=>'Wynik został poprawiony. Ranking przeliczono ponownie.']);
        }
        if($action!=='close')wp_send_json_error('Nieznana akcja.');if($tb->status!=='active')wp_send_json_error('Ten stół nie jest aktywny.');
        $players=$wpdb->get_results($wpdb->prepare("SELECT * FROM {$t['table_players']} WHERE table_id=%d ORDER BY id",$tid));$ranking=(int)$tb->ranking_id;if(!$ranking)wp_send_json_error('Brak rankingu.');if(count($players)<1)wp_send_json_error('Brak graczy.');
        $results=[];$winners=0;foreach($players as $p){$raw=isset($_POST['points'][$p->user_id])?wp_unslash($_POST['points'][$p->user_id]):'0';$points=is_numeric($raw)?(float)$raw:0;$win=!empty($_POST['winner'][$p->user_id])?1:0;if($win)$winners++;$results[]=['user_id'=>(int)$p->user_id,'points'=>$points,'winner'=>$win];}
        if(!$winners)wp_send_json_error('Zaznacz przynajmniej jednego zwycięzcę.');usort($results,function($a,$b){return $b['points']<=>$a['points'];});$count=count($results);$last=null;$place=0;
        foreach($results as $i=>$r){if($last===null||$r['points']<$last)$place=$i+1;$last=$r['points'];$rp=max(1,$count-$place+1);$wpdb->insert($t['results'],['table_id'=>$tid,'user_id'=>$r['user_id'],'ranking_id'=>$ranking,'points'=>$r['points'],'winner'=>$r['winner'],'rank_place'=>$place,'ranking_points'=>$rp,'created_at'=>current_time('mysql')]);}
        $wpdb->update($t['tables'],['status'=>'closed','closed_at'=>current_time('mysql')],['id'=>$tid]);wp_send_json_success(['message'=>'Wynik zapisany. Ranking został zaktualizowany.']);
    }

    public function ajax_ranking_action(){
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.');
        if(!is_user_logged_in()) wp_send_json_error('Brak logowania.');
        $rid=(int)($_POST['ranking']??0);
        $action=sanitize_key($_POST['do']??'');
        if($action!=='delete') wp_send_json_error('Nieznana akcja.');
        global $wpdb; $t=$this->tables(); $uid=get_current_user_id();
        $rk=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['rankings']} WHERE id=%d",$rid));
        if(!$rk || (int)$rk->owner_id!==$uid) wp_send_json_error('Tylko autor rankingu może go usunąć.');
        $active=$wpdb->get_var($wpdb->prepare("SELECT id FROM {$t['tables']} WHERE ranking_id=%d AND status IN('voting','active') LIMIT 1",$rid));
        if($active) wp_send_json_error('Nie można usunąć rankingu, który jest używany przez aktywny stół.');
        $wpdb->delete($t['results'],['ranking_id'=>$rid]);
        $wpdb->delete($t['ranking_players'],['ranking_id'=>$rid]);
        $wpdb->delete($t['rankings'],['id'=>$rid]);
