    private function import_gc(){
        global $wpdb;$n=0;
        $types=[]; if(post_type_exists('gc_game'))$types[]='gc_game'; if(post_type_exists('games_collector'))$types[]='games_collector';
        if(!$types)return 0;
        foreach($types as $type){$q=new WP_Query(['post_type'=>$type,'posts_per_page'=>-1,'post_status'=>'publish','no_found_rows'=>true]);foreach($q->posts as $p){$img=get_the_post_thumbnail_url($p->ID,'medium')?:'';$gid=$this->upsert_game(['bgg_id'=>0,'title'=>$p->post_title,'image_url'=>$img,'bgg_url'=>''],'planszownia',$p->ID);if($gid)$n++;}}
        return $n;
    }

    private function clear_club_library(){
        global $wpdb;
        $t=$this->tables();
        return (int)$wpdb->query("DELETE FROM {$t['games']} WHERE source='planszownia'");
    }

    private function sync_club_bgg($name){
        if(!$name)return new WP_Error('no_name','Podaj nazwę użytkownika BGG Planszowni.');
        $name=trim($name);
        $xml=$this->bgg_request('collection',['username'=>$name,'own'=>1,'excludesubtype'=>'boardgameexpansion']);
        if(is_wp_error($xml))return $xml;$n=0;
        foreach($xml->item as $i){$id=(int)$i['objectid'];$title=(string)$i->name;if(!$id||!$title)continue;$img=(string)($i->image??'');$this->upsert_game(['bgg_id'=>$id,'title'=>$title,'image_url'=>$img,'bgg_url'=>'https://boardgamegeek.com/boardgame/'.$id],'planszownia');$n++;}
        return $n;
    }

    public function ajax_request_loan(){
        $this->ensure_loan_storage();
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.');
        if(!is_user_logged_in()) wp_send_json_error('Brak logowania.');
        $gid=(int)($_POST['game']??0); if(!$gid) wp_send_json_error('Brak gry.');
        global $wpdb; $t=$this->tables(); $uid=get_current_user_id();
        $game=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['games']} WHERE id=%d AND (source='planszownia' OR source='games-collector')",$gid));
        if(!$game) wp_send_json_error('Tej gry nie ma w bibliotece Planszowni.');
        if(isset($game->loan_enabled) && !(int)$game->loan_enabled) wp_send_json_error('Ta gra nie jest obecnie dostępna do wypożyczenia.');
        $mine=$wpdb->get_var($wpdb->prepare("SELECT id FROM {$t['loans']} WHERE game_id=%d AND user_id=%d AND status='requested' LIMIT 1",$gid,$uid));
        if($mine) wp_send_json_error('Masz już aktywną prośbę o tę grę.');
        $active=$this->club_loan($gid);
        if($active) wp_send_json_error($active->status==='borrowed'?'Gra jest już wypożyczona.':'Ktoś już zgłosił chęć wypożyczenia tej gry.');
        $inserted=$wpdb->insert($t['loans'],[
            'game_id'=>$gid,'user_id'=>$uid,'status'=>'requested','requested_at'=>current_time('mysql')
        ],['%d','%d','%s','%s']);
        if($inserted===false) wp_send_json_error('Nie udało się zapisać prośby o wypożyczenie. Spróbuj ponownie.');
        wp_send_json_success(['message'=>'Zgłoszenie wypożyczenia zostało wysłane.','loan'=>(int)$wpdb->insert_id,'game'=>$gid]);
    }

    public function ajax_loan_action(){
        $this->ensure_loan_storage();
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.');
        if(!current_user_can('manage_options')) wp_send_json_error('Brak uprawnień administratora.');
        $lid=(int)($_POST['loan']??0); $do=sanitize_key($_POST['do']??'');
        if(!$lid || !in_array($do,['approve','reject','return'],true)) wp_send_json_error('Nieprawidłowa akcja.');
        global $wpdb; $t=$this->tables();
        $loan=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['loans']} WHERE id=%d",$lid));
        if(!$loan) wp_send_json_error('Nie znaleziono wypożyczenia.');
        if($do==='approve'){
            $other=$wpdb->get_var($wpdb->prepare("SELECT id FROM {$t['loans']} WHERE game_id=%d AND status='borrowed' AND id<>%d LIMIT 1",(int)$loan->game_id,$lid));
            if($other) wp_send_json_error('Ta gra jest już wypożyczona.');
            $wpdb->update($t['loans'],['status'=>'borrowed','approved_at'=>current_time('mysql')],['id'=>$lid]);
            wp_send_json_success(['message'=>'Wypożyczenie potwierdzone.']);
        }
        if($do==='reject'){
            $reason=sanitize_text_field(wp_unslash($_POST['reason']??'Odmowa wypożyczenia przez Planszownię.'));
            $ok=$wpdb->update($t['loans'],['status'=>'rejected','decision_note'=>$reason],['id'=>$lid],['%s','%s'],['%d']);
            if($ok===false) wp_send_json_error('Nie udało się zapisać decyzji.');
            wp_send_json_success(['message'=>'Zgłoszenie odrzucone.','reason'=>$reason]);
        }
        $wpdb->update($t['loans'],['status'=>'returned','returned_at'=>current_time('mysql')],['id'=>$lid]);
        wp_send_json_success(['message'=>'Zwrot potwierdzony. Gra jest ponownie dostępna.']);
    }

    public function ajax_voting_status(){
        if(!is_user_logged_in())wp_send_json_error('Zaloguj się.');
        $tid=(int)($_POST['table_id']??0); global $wpdb; $t=$this->tables();
        $ok=(int)$wpdb->get_var($wpdb->prepare("SELECT COUNT(*) FROM {$t['table_players']} WHERE table_id=%d AND user_id=%d",$tid,get_current_user_id()));
        if(!$ok)wp_send_json_error('Brak dostępu.');
        wp_send_json_success(['html'=>$this->voting_players_html($tid)]);
    }

