    public function ajax_sync_my_bgg(){
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.'); if(!is_user_logged_in()) wp_send_json_error('Brak logowania.');
        $uid=get_current_user_id();
        $name=sanitize_text_field(wp_unslash($_POST['username']??''));
        $name=preg_replace('/\s+/',' ',$name);
        if(!$name) wp_send_json_error('Podaj dokładną nazwę użytkownika BGG.');
        update_user_meta($uid,'pw_bgg_username',$name);

        $xml=$this->bgg_request('collection',['username'=>trim($name),'own'=>1,'excludesubtype'=>'boardgameexpansion']);
        if(is_wp_error($xml)) wp_send_json_error($xml->get_error_message());

        global $wpdb;$t=$this->tables();$n=0;$seen=[];
        foreach($xml->item as $i){
            $id=(int)$i['objectid'];
            $title=trim((string)$i->name);
            if(!$id||!$title) continue;

            // Collection responses can omit image URLs. Fetch the game record from BGG
            // in that case so the library gets the proper cover whenever possible.
            $img=trim((string)($i->image??''));
            if(!$img) $img=trim((string)($i->thumbnail??''));
            if(!$img){
                $details=$this->bgg_game($id);
                if(!is_wp_error($details)){
                    $title=$details['title']?:$title;
                    $img=$details['image_url'];
                }
            }

            $gid=$this->upsert_game([
                'bgg_id'=>$id,
                'title'=>$title,
                'image_url'=>$img,
                'bgg_url'=>'https://boardgamegeek.com/boardgame/'.$id
            ],'bgg');
            $this->attach_game($uid,$gid,true);
            $seen[]=$gid;
            $n++;
        }

        // A successful empty collection is valid: remove previous BGG-synced games,
        // while keeping games that the user added manually.
        if($seen){
            $placeholders=implode(',',array_fill(0,count($seen),'%d'));
            $wpdb->query($wpdb->prepare("DELETE FROM {$t['player_games']} WHERE user_id=%d AND is_bgg_sync=1 AND game_id NOT IN ($placeholders)",array_merge([$uid],$seen)));
        }else{
            $wpdb->delete($t['player_games'],['user_id'=>$uid,'is_bgg_sync'=>1]);
        }

        $message=$n===0
            ? 'Połączenie z BGG działa, ale konto nie ma gier oznaczonych jako posiadane (OWN). Sprawdź kolekcję na BGG i zaznaczenie „Own”.'
            : 'Zsynchronizowano '.$n.' gier z BGG dla użytkownika „'.$name.'”.';
        wp_send_json_success(['message'=>$message,'count'=>$n]);
    }

