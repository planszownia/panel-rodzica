    private function ranking_stats($rid){
        global $wpdb;$t=$this->tables();
        return $wpdb->get_results($wpdb->prepare("SELECT u.display_name,COUNT(r.id) games,COALESCE(SUM(r.winner),0) wins,CASE WHEN COUNT(r.id)>0 THEN (SUM(r.winner)/COUNT(r.id))*100 ELSE 0 END pct,COALESCE(SUM(r.ranking_points),0) score FROM {$t['ranking_players']} rp INNER JOIN {$wpdb->users} u ON u.ID=rp.user_id LEFT JOIN {$t['results']} r ON r.user_id=rp.user_id AND r.ranking_id=rp.ranking_id WHERE rp.ranking_id=%d GROUP BY rp.user_id,u.display_name ORDER BY score DESC,pct DESC,games DESC,u.display_name ASC",$rid));
    }

