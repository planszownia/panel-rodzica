    private function maybe_activate($tid){
        global $wpdb;$t=$this->tables();$tb=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['tables']} WHERE id=%d",$tid));if(!$tb||$tb->status!=='voting')return;
        $players=$wpdb->get_results($wpdb->prepare("SELECT * FROM {$t['table_players']} WHERE table_id=%d ORDER BY id",$tid));
        $all=true;foreach($players as $p)if(!$p->vote_game_id){$all=false;break;}
        $deadline_due=$tb->vote_deadline && strtotime($tb->vote_deadline)<=current_time('timestamp');
        if($all||$deadline_due){
            $options=$wpdb->get_results($wpdb->prepare("SELECT * FROM {$t['table_options']} WHERE table_id=%d ORDER BY position ASC,id ASC",$tid));
            if(!$options){$wpdb->update($t['tables'],['status'=>'closed','closed_at'=>current_time('mysql')],['id'=>$tid]);return;}
            $winner_id=(int)$options[0]->game_id;$best=-1;
            foreach($options as $o){$votes=(int)$wpdb->get_var($wpdb->prepare("SELECT COUNT(*) FROM {$t['table_players']} WHERE table_id=%d AND vote_game_id=%d",$tid,$o->game_id));if($votes>$best){$best=$votes;$winner_id=(int)$o->game_id;}}
            // Przy remisie zostaje pierwsza opcja, bo sprawdzamy je w kolejności position/id i zmieniamy zwycięzcę tylko przy ścisłym >.
            $wpdb->update($t['tables'],['game_id'=>$winner_id,'status'=>'active','started_at'=>current_time('mysql'),'vote_deadline'=>null],['id'=>$tid]);
        }
    }

