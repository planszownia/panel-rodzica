    private function bgg_request($path,$args=[]){
        $s=$this->settings();
        if(empty($s['bgg_token'])) return new WP_Error('no_token','Brak tokena BGG w ustawieniach wtyczki.');
        $url='https://boardgamegeek.com/xmlapi2/'.ltrim($path,'/');
        if($args) $url=add_query_arg($args,$url);
        $headers=[
            'Authorization'=>'Bearer '.trim($s['bgg_token']),
            'Accept'=>'application/xml,text/xml;q=0.9,*/*;q=0.8',
            'User-Agent'=>'Planszownia-Gracz/'.self::VER.' (+https://planszownia.pl)',
        ];

        // BGG can queue collection/user requests and answer with HTTP 202.
        // A single 2-second retry is not reliable enough, especially for larger collections.
        $last_code=0;
        $last_body='';
        for($attempt=1;$attempt<=7;$attempt++){
            $r=wp_remote_get($url,['timeout'=>30,'headers'=>$headers,'redirection'=>3]);
            if(is_wp_error($r)) return $r;
            $last_code=(int)wp_remote_retrieve_response_code($r);
            $last_body=wp_remote_retrieve_body($r);

            if($last_code===200){
                $xml=@simplexml_load_string($last_body);
                if(!$xml) return new WP_Error('bgg_xml','BGG zwróciło odpowiedź, której nie udało się odczytać.');
                return $xml;
            }

            if($last_code===202 || $last_code===429){
                $retry=(int)wp_remote_retrieve_header($r,'retry-after');
                if($retry<1) $retry=2;
                if($retry>5) $retry=5;
                if($attempt<7) sleep($retry);
                continue;
            }

            $detail='';
            if($last_code===401 || $last_code===403) $detail=' Token aplikacji BGG jest nieprawidłowy, wygasł albo nie jest zapisany w tej instalacji wtyczki.';
            elseif($last_code===404) $detail=' Nie znaleziono użytkownika lub zasobu BGG.';
            return new WP_Error('bgg_http','BGG zwróciło HTTP '.$last_code.'.'.$detail);
        }

        return new WP_Error('bgg_queued','BGG nadal przetwarza żądanie po kilku próbach (HTTP '.$last_code.'). Spróbuj ponownie za chwilę.');
    }

    private function upsert_game($data,$source='bgg',$gc_post_id=0){
