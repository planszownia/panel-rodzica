    private function ranking_members($rid){
        global $wpdb;$t=$this->tables(); return $wpdb->get_results($wpdb->prepare("SELECT u.ID,u.display_name FROM {$t['ranking_players']} rp INNER JOIN {$wpdb->users} u ON u.ID=rp.user_id WHERE rp.ranking_id=%d ORDER BY u.display_name ASC",$rid));
