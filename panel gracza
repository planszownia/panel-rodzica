    public function ajax_save_loan_settings(){
        $this->ensure_loan_storage();
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła. Odśwież stronę i spróbuj ponownie.');
        if(!current_user_can('manage_options')) wp_send_json_error('Brak uprawnień administratora.');
        global $wpdb; $t=$this->tables();
        $has=$wpdb->get_var($wpdb->prepare("SHOW COLUMNS FROM {$t['games']} LIKE %s",'loan_enabled'));
        if(!$has) $wpdb->query("ALTER TABLE {$t['games']} ADD loan_enabled tinyint(1) NOT NULL DEFAULT 1");
        $raw=isset($_POST['games']) && is_array($_POST['games']) ? $_POST['games'] : [];
        $club=$wpdb->get_col("SELECT id FROM {$t['games']} WHERE source='planszownia' OR source='games-collector'");
        $saved=0;
        foreach($club as $gid){
            $enabled=array_key_exists((string)$gid,$raw) ? (!empty($raw[(string)$gid])?1:0) : (array_key_exists($gid,$raw)?(!empty($raw[$gid])?1:0):1);
            $ok=$wpdb->update($t['games'],['loan_enabled'=>$enabled],['id'=>(int)$gid],['%d'],['%d']);
            if($ok!==false) $saved++;
            if(!$enabled) $wpdb->query($wpdb->prepare("DELETE FROM {$t['loans']} WHERE game_id=%d AND status='requested'",(int)$gid));
        }
        wp_send_json_success(['message'=>'Ustawienia wypożyczeń zapisane.','saved'=>$saved]);
    }

    public function ajax_loan_status(){
        $this->ensure_loan_storage();
        if(!is_user_logged_in()) wp_send_json_error('Zaloguj się.');
        $ids=isset($_POST['games']) && is_array($_POST['games']) ? array_map('intval',$_POST['games']) : [];
        if(!$ids) wp_send_json_success(['items'=>[]]);
        global $wpdb; $t=$this->tables(); $out=[];
        foreach(array_unique($ids) as $gid){
            $g=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['games']} WHERE id=%d AND (source='planszownia' OR source='games-collector')",$gid));
            if($g) $out[$gid]=$this->render_loan_status($g);
        }
        wp_send_json_success(['items'=>$out]);
    }

    public function ajax_cancel_loan(){
        $this->ensure_loan_storage();
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.');
        if(!is_user_logged_in()) wp_send_json_error('Brak logowania.');
        $lid=(int)($_POST['loan']??0); global $wpdb; $t=$this->tables();
        $loan=$wpdb->get_row($wpdb->prepare("SELECT * FROM {$t['loans']} WHERE id=%d",$lid));
        if(!$loan || (int)$loan->user_id!==get_current_user_id()) wp_send_json_error('Nie możesz anulować tej prośby.');
        if($loan->status!=='requested') wp_send_json_error('Ta prośba nie oczekuje już na decyzję.');
        $wpdb->delete($t['loans'],['id'=>$lid]);
        wp_send_json_success(['message'=>'Prośba o wypożyczenie została anulowana.']);
    }

    public function ajax_toggle_loan(){
        $this->ensure_loan_storage();
        if(!$this->nonce_ok()) wp_send_json_error('Sesja wygasła.');
        if(!current_user_can('manage_options')) wp_send_json_error('Brak uprawnień administratora.');
        $gid=(int)($_POST['game']??0); $enabled=!empty($_POST['enabled'])?1:0;
        if(!$gid) wp_send_json_error('Brak gry.');
        global $wpdb; $t=$this->tables();
        $ok=$wpdb->update($t['games'],['loan_enabled'=>$enabled],['id'=>$gid]);
        if($ok===false) wp_send_json_error('Nie udało się zapisać ustawienia.');
        if(!$enabled) $wpdb->query($wpdb->prepare("DELETE FROM {$t['loans']} WHERE game_id=%d AND status='requested'",$gid));
        wp_send_json_success(['message'=>$enabled?'Wypożyczenie włączone.':'Wypożyczenie wyłączone.']);
    }

