    private function game_card($g,$editable=false) {
        $img=$g->image_url ?: plugins_url('assets/placeholder.svg',__FILE__);
        $out='<article class="pw-game" data-title="'.esc_attr(function_exists('mb_strtolower')?mb_strtolower($g->title):strtolower($g->title)).'">';
        $out.='<div class="pw-cover"><img loading="lazy" src="'.esc_url($img).'" alt=""></div><div class="pw-game-body"><strong>'.esc_html($g->title).'</strong><div class="pw-game-meta">'.($g->bgg_id?'BGG #'.(int)$g->bgg_id:'Gra dodana ręcznie').'</div>';
        if(!empty($g->bgg_url)) $out.='<a class="pw-link" target="_blank" rel="noopener" href="'.esc_url($g->bgg_url).'">Zobacz w BGG</a>';
        if($g->source==='planszownia' || $g->source==='games-collector'){
            $out.='<div class="pw-loan-box" data-game="'.(int)$g->id.'">'.$this->render_loan_status($g).'</div>';
            if(current_user_can('manage_options')){
                $enabled=isset($g->loan_enabled)?(int)$g->loan_enabled:1;
                $out.='<div class="pw-admin-loan-tile '.($enabled?'is-on':'is-off').'" data-game="'.(int)$g->id.'">';
                $out.='<span class="pw-admin-loan-dot"></span><span class="pw-admin-loan-label">'.($enabled?'Wypożyczanie włączone':'Wypożyczanie wyłączone').'</span>';
                $out.='<label class="pw-admin-switch"><input type="checkbox" class="pw-loan-toggle" data-game="'.(int)$g->id.'" '.checked($enabled,1,false).'><span></span></label></div>';
            }
        }
        if($editable && empty($g->bgg_id)) $out.='<button type="button" class="pw-link pw-enrich-game" data-game="'.(int)$g->id.'">Pobierz okładkę z BGG</button>';
        if($editable) $out.='<button type="button" class="pw-link pw-remove-game" data-game="'.(int)$g->id.'">Usuń z biblioteki</button>';
        $out.='</div></article>'; return $out;
    }

