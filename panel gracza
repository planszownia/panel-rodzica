    private function tables() {
        global $wpdb;
        return [
            'games'        => $wpdb->prefix.'pw_games',
            'player_games' => $wpdb->prefix.'pw_player_games',
            'tables'       => $wpdb->prefix.'pw_tables',
            'table_players'=> $wpdb->prefix.'pw_table_players',
            'table_options'=> $wpdb->prefix.'pw_table_options',
            'rankings'     => $wpdb->prefix.'pw_rankings',
            'ranking_players'=> $wpdb->prefix.'pw_ranking_players',
            'results'      => $wpdb->prefix.'pw_results',
            'loans'        => $wpdb->prefix.'pw_loans',
        ];
    }

    private function schema() {
        global $wpdb;
        require_once ABSPATH.'wp-admin/includes/upgrade.php';
        $t=$this->tables(); $c=$wpdb->get_charset_collate();
        $sql=[];
        $sql[]="CREATE TABLE {$t['games']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            bgg_id bigint unsigned NULL,
            title varchar(255) NOT NULL,
            image_url text NULL,
            bgg_url text NULL,
            source varchar(30) NOT NULL DEFAULT 'bgg',
            gc_post_id bigint unsigned NULL,
            loan_enabled tinyint(1) NOT NULL DEFAULT 1,
            created_at datetime NOT NULL,
            updated_at datetime NOT NULL,
            PRIMARY KEY(id), KEY bgg_id(bgg_id), KEY title(title(100)), KEY gc_post_id(gc_post_id)
        ) $c;";
        $sql[]="CREATE TABLE {$t['player_games']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            user_id bigint unsigned NOT NULL,
            game_id bigint unsigned NOT NULL,
            is_bgg_sync tinyint(1) NOT NULL DEFAULT 0,
            added_at datetime NOT NULL,
            PRIMARY KEY(id), UNIQUE KEY user_game(user_id,game_id), KEY user_id(user_id), KEY game_id(game_id)
        ) $c;";
        $sql[]="CREATE TABLE {$t['tables']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            owner_id bigint unsigned NOT NULL,
            game_id bigint unsigned NOT NULL,
            ranking_id bigint unsigned NULL,
            status varchar(20) NOT NULL DEFAULT 'voting',
            vote_deadline datetime NULL,
            created_at datetime NOT NULL,
            started_at datetime NULL,
            closed_at datetime NULL,
            PRIMARY KEY(id), KEY owner_id(owner_id), KEY game_id(game_id), KEY ranking_id(ranking_id), KEY status(status)
        ) $c;";
        $sql[]="CREATE TABLE {$t['table_players']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            table_id bigint unsigned NOT NULL,
            user_id bigint unsigned NOT NULL,
            vote varchar(10) NULL,
            vote_game_id bigint unsigned NULL,
            points decimal(10,2) NULL,
            winner tinyint(1) NOT NULL DEFAULT 0,
            joined_at datetime NOT NULL,
            PRIMARY KEY(id), UNIQUE KEY table_user(table_id,user_id), KEY table_id(table_id), KEY user_id(user_id)
        ) $c;";
        $table_options=$t['table_options'];
        $sql[]="CREATE TABLE ".$table_options." (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            table_id bigint unsigned NOT NULL,
            game_id bigint unsigned NOT NULL,
            position int unsigned NOT NULL DEFAULT 1,
            created_at datetime NOT NULL,
            PRIMARY KEY(id), UNIQUE KEY table_game(table_id,game_id), KEY table_id(table_id), KEY game_id(game_id)
         ) $c;";
        $sql[]="CREATE TABLE {$t['rankings']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            owner_id bigint unsigned NOT NULL,
            name varchar(255) NOT NULL,
            created_at datetime NOT NULL,
            PRIMARY KEY(id), KEY owner_id(owner_id)
        ) $c;";
        $sql[]="CREATE TABLE {$t['ranking_players']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            ranking_id bigint unsigned NOT NULL,
            user_id bigint unsigned NOT NULL,
            joined_at datetime NOT NULL,
            PRIMARY KEY(id), UNIQUE KEY ranking_user(ranking_id,user_id), KEY ranking_id(ranking_id), KEY user_id(user_id)
        ) $c;";
        $sql[]="CREATE TABLE {$wpdb->prefix}pw_loans (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            game_id bigint unsigned NOT NULL,
            user_id bigint unsigned NOT NULL,
            status varchar(20) NOT NULL DEFAULT 'requested',
            requested_at datetime NOT NULL,
            approved_at datetime NULL,
            returned_at datetime NULL,
            PRIMARY KEY(id), KEY game_id(game_id), KEY user_id(user_id), KEY status(status)
        ) $c;";
        $sql[]="CREATE TABLE {$t['results']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            table_id bigint unsigned NOT NULL,
            user_id bigint unsigned NOT NULL,
            ranking_id bigint unsigned NOT NULL,
            points decimal(10,2) NOT NULL DEFAULT 0,
            winner tinyint(1) NOT NULL DEFAULT 0,
            rank_place int unsigned NULL,
            ranking_points decimal(10,2) NOT NULL DEFAULT 0,
            created_at datetime NOT NULL,
            PRIMARY KEY(id), KEY table_id(table_id), KEY user_id(user_id), KEY ranking_id(ranking_id)
        ) $c;";
        foreach($sql as $q) dbDelta($q);
    }


    private function voting_players_html($table_id){
        global $wpdb; $t=$this->tables();
        $rows=$wpdb->get_results($wpdb->prepare(
            "SELECT tp.user_id,tp.vote_game_id,u.display_name FROM {$t['table_players']} tp
             INNER JOIN {$wpdb->users} u ON u.ID=tp.user_id
             WHERE tp.table_id=%d ORDER BY tp.id",(int)$table_id
        ),ARRAY_A);
        if(!$rows)return '';
        $out='<div class="pw-voting-players" data-table-id="'.(int)$table_id.'"><div class="pw-voting-players-title">👥 Głosy graczy</div>';
        foreach($rows as $r){
            $name=$r['display_name']?:'Gracz'; $game='';
            if(!empty($r['vote_game_id'])){
                $g=$wpdb->get_row($wpdb->prepare("SELECT title FROM {$t['games']} WHERE id=%d",(int)$r['vote_game_id']),ARRAY_A);
                if($g)$game=$g['title'];
            }
            $initial=function_exists('mb_substr')?mb_substr($name,0,1):substr($name,0,1);
            $initial=function_exists('mb_strtoupper')?mb_strtoupper($initial):strtoupper($initial);
            $out.='<div class="pw-voter-row"><span class="pw-voter-avatar">'.esc_html($initial).'</span><span class="pw-voter-name">'.esc_html($name).'</span>';
            $out.=$game?'<span class="pw-voter-vote">✓ '.esc_html($game).'</span>':'<span class="pw-voter-pending">jeszcze nie zagłosował</span>';
            $out.='</div>';
        }
        return $out.'</div>';
    }

    public function activate() {
        $this->schema();
        if (!get_option(self::OPT)) update_option(self::OPT, ['bgg_token'=>'','planszownia_bgg'=>'','powered_by_bgg'=>1]);
        update_option('pw_gracz_db_version', self::DB_VER);
        $this->cron_setup();

        // If Ultimate Member is already active, enable the custom profile tab.
        if ( function_exists('UM') && is_object( UM() ) && method_exists( UM(), 'options' ) ) {
            UM()->options()->update('profile_tab_gracz', true);
        }

        flush_rewrite_rules();
    }

    public function maybe_upgrade() {
        if (get_option('pw_gracz_db_version') !== self::DB_VER) {
            $this->schema();
            update_option('pw_gracz_db_version', self::DB_VER);
        }
        // Safety migration: older installations may already have pw_games without loan_enabled.
        global $wpdb;
        $games_table=$this->tables()['games'];
        $has_column=$wpdb->get_var($wpdb->prepare("SHOW COLUMNS FROM {$games_table} LIKE %s", 'loan_enabled'));
        if (!$has_column) {
            $wpdb->query("ALTER TABLE {$games_table} ADD loan_enabled tinyint(1) NOT NULL DEFAULT 1");
        }
        $s=$this->settings();
        if (!isset($s['powered_by_bgg'])) { $s['powered_by_bgg']=1; update_option(self::OPT,$s); }
    }

    private function ensure_loan_storage() {
        global $wpdb; $t=$this->tables(); $c=$wpdb->get_charset_collate();
        $wpdb->query("CREATE TABLE IF NOT EXISTS {$t['loans']} (
            id bigint unsigned NOT NULL AUTO_INCREMENT,
            game_id bigint unsigned NOT NULL,
            user_id bigint unsigned NOT NULL,
            status varchar(20) NOT NULL DEFAULT 'requested',
            requested_at datetime NOT NULL,
            approved_at datetime NULL,
            returned_at datetime NULL,
            PRIMARY KEY(id), KEY game_id(game_id), KEY user_id(user_id), KEY status(status)
        ) $c;");
        $has=$wpdb->get_var($wpdb->prepare("SHOW COLUMNS FROM {$t['games']} LIKE %s",'loan_enabled'));
        if(!$has) $wpdb->query("ALTER TABLE {$t['games']} ADD loan_enabled tinyint(1) NOT NULL DEFAULT 1");
        $has_reason=$wpdb->get_var($wpdb->prepare("SHOW COLUMNS FROM {$t['loans']} LIKE %s",'decision_note'));
        if(!$has_reason) $wpdb->query("ALTER TABLE {$t['loans']} ADD decision_note varchar(255) NULL");

    }

    private function settings() {
        return wp_parse_args(get_option(self::OPT, []), ['bgg_token'=>'','planszownia_bgg'=>'','powered_by_bgg'=>1]);
    }
    private function is_um() { return function_exists('um_profile_id'); }
    private function current_profile_id() { return $this->is_um() ? (int)um_profile_id() : get_current_user_id(); }
    private function nonce_ok() { return check_ajax_referer('pw_gracz','nonce',false); }

    public function cron_setup() {
        if (!wp_next_scheduled('pw_gracz_cron')) wp_schedule_event(time()+300, 'hourly', 'pw_gracz_cron');
    }

    public function assets() {
        if (!is_user_logged_in()) return;
        wp_enqueue_style('pw-gracz', plugins_url('assets/gracz.css', __FILE__), [], self::VER);
        wp_enqueue_script('pw-gracz', plugins_url('assets/gracz.js', __FILE__), ['jquery'], self::VER, true);
        wp_localize_script('pw-gracz', 'PWGracz', [
            'ajax'=>admin_url('admin-ajax.php'),
            'ajaxurl'=>admin_url('admin-ajax.php'),
            'nonce'=>wp_create_nonce('pw_gracz'),
            'profile'=>get_current_user_id(),
            'canCreate'=>$this->can_create_table(get_current_user_id()) ? 1 : 0,
            'i18n'=>['error'=>'Wystąpił błąd. Spróbuj ponownie.']
        ]);
    }

    /**
     * Make sure Ultimate Member knows that our custom profile tab is enabled.
     * UM stores custom profile-tab visibility in its options. Without this,
     * some UM versions can silently omit a custom tab even though the
     * um_profile_tabs filter is registered correctly.
     */
    public function ensure_um_profile_tab() {
        if ( ! function_exists('UM') || ! is_object( UM() ) || ! method_exists( UM(), 'options' ) ) {
            return;
        }

        $option_key = 'profile_tab_gracz';
        $current = UM()->options()->get( $option_key );

        if ( '' === $current || null === $current || false === $current ) {
            UM()->options()->update( $option_key, true );
        }
    }

    public function um_tab($tabs) {
        $tabs['gracz'] = [
            'name' => 'Gracz',
            'icon' => 'um-faicon-gamepad',
            'custom' => true,
            'default_privacy' => 2,
        ];
        return $tabs;
    }


    private function club_loan($game_id){
        global $wpdb; $t=$this->tables();
        return $wpdb->get_row($wpdb->prepare(
            "SELECT l.*,u.display_name FROM {$t['loans']} l
             INNER JOIN {$wpdb->users} u ON u.ID=l.user_id
             WHERE l.game_id=%d AND l.status IN('requested','borrowed')
             ORDER BY CASE WHEN l.status='borrowed' THEN 0 ELSE 1 END,l.requested_at ASC LIMIT 1",
            (int)$game_id
        ));
    }

    private function club_game_available($game_id){
        $loan=$this->club_loan($game_id);
        return !$loan;
    }

    private function render_loan_status($game){
        if(isset($game->loan_enabled) && !(int)$game->loan_enabled){
            return '<span class="pw-loan-status pw-loan-disabled"><i></i> Wypożyczenie niedostępne</span>';
        }
        $loan=$this->club_loan($game->id);
        $uid=get_current_user_id();
        if(!$loan){
            return '<span class="pw-loan-status pw-loan-available"><i></i> Dostępna w klubie</span>'.
                   (is_user_logged_in()?'<button type="button" class="pw-loan-request" data-game="'.(int)$game->id.'">📦 Chcę wypożyczyć</button>':'');
        }
        if($loan->status==='requested'){
            $mine=((int)$loan->user_id===$uid);
            return '<span class="pw-loan-status pw-loan-requested"><i></i> Zarezerwowana — oczekuje na decyzję</span>'.
                   '<span class="pw-loan-who">Chce wypożyczyć: <b>'.esc_html($loan->display_name).'</b></span>'.
                   ($mine?'<button type="button" class="pw-loan-cancel" data-loan="'.(int)$loan->id.'" data-game="'.(int)$game->id.'">Anuluj prośbę</button>':'');
        }
        return '<span class="pw-loan-status pw-loan-borrowed"><i></i> Wypożyczona</span>'.
               '<span class="pw-loan-who">Wypożyczona przez: <b>'.esc_html($loan->display_name).'</b></span>';
    }

    private function render_my_loans($uid){
        global $wpdb; $t=$this->tables();
        $rows=$wpdb->get_results($wpdb->prepare("SELECT l.*,g.title,g.image_url FROM {$t['loans']} l INNER JOIN {$t['games']} g ON g.id=l.game_id WHERE l.user_id=%d ORDER BY l.requested_at DESC LIMIT 100",$uid));
        ob_start();
        echo '<div class="pw-card pw-my-loans"><div class="pw-section-head"><div><h3>📦 Moje wypożyczenia</h3><p>Tu widzisz swoje prośby, decyzje i aktualne wypożyczenia.</p></div><span class="pw-count">'.count($rows).'</span></div>';
        if(!$rows) echo '<div class="pw-empty pw-wide">Nie masz jeszcze żadnych próśb o wypożyczenie.</div>';
        else{
            echo '<div class="pw-my-loans-list">';
            foreach($rows as $r){
                $status=$r->status;
                if($status==='requested') {$label='🟡 Oczekuje na decyzję'; $cls='requested';}
                elseif($status==='borrowed') {$label='🔴 Wypożyczona'; $cls='borrowed';}
                elseif($status==='rejected') {$label='⚪ Odrzucona'; $cls='rejected';}
                elseif($status==='returned') {$label='🟢 Zwrócona'; $cls='returned';}
                else {$label='⚪ Zakończona'; $cls='rejected';}
                echo '<div class="pw-my-loan-row"><strong>'.esc_html($r->title).'</strong><span class="pw-my-loan-status '.$cls.'">'.$label.'</span>';
                if($status==='requested') echo '<button type="button" class="pw-btn pw-btn-light pw-loan-cancel" data-loan="'.(int)$r->id.'">Anuluj prośbę</button>';
                echo '</div>';
            }
