 * 3. ZAKŁADKA KONTO
 * ========================================================= */

add_action(
    'um_profile_content_konto',
    'planszownia_profile_konto',
    10,
    1
);

function planszownia_profile_konto($args) {

    if (!is_user_logged_in()) {
        return;
    }

    $user_id = get_current_user_id();
    $user    = get_userdata($user_id);

    if (!$user) {
        return;
    }


    /* =====================================================
     * ZAPIS FORMULARZA
     * ===================================================== */

    if (
        isset($_POST['planszownia_konto_submit']) &&
        isset($_POST['planszownia_konto_nonce'])
    ) {

        if (
            wp_verify_nonce(
                sanitize_text_field(
                    wp_unslash(
                        $_POST['planszownia_konto_nonce']
                    )
                ),
                'planszownia_konto_save'
            )
        ) {

            /*
             * IMIĘ
             */
            $first_name = isset($_POST['first_name'])
                ? sanitize_text_field(
                    wp_unslash($_POST['first_name'])
                )
                : '';

            /*
             * NAZWISKO
             */
            $last_name = isset($_POST['last_name'])
                ? sanitize_text_field(
                    wp_unslash($_POST['last_name'])
                )
                : '';

            /*
             * EMAIL
             */
            $email = isset($_POST['user_email'])
                ? sanitize_email(
                    wp_unslash($_POST['user_email'])
                )
                : '';

            $errors = array();


            /*
             * SPRAWDZENIE EMAILA
             */
            if (
                empty($email) ||
                !is_email($email)
            ) {

                $errors[] =
                    'Podaj prawidłowy adres e-mail.';

            } else {

                $email_owner = email_exists($email);

                if (
                    $email_owner &&
                    (int) $email_owner !== (int) $user_id
                ) {

                    $errors[] =
                        'Ten adres e-mail jest już używany przez inne konto.';
                }
            }


            /*
             * NOWE HASŁO
             */
            $password = isset($_POST['new_password'])
                ? (string) wp_unslash($_POST['new_password'])
                : '';

            $password_confirm = isset($_POST['new_password_confirm'])
                ? (string) wp_unslash($_POST['new_password_confirm'])
                : '';


            /*
             * SPRAWDZENIE HASŁA
             */
            if ($password !== '') {

                if (strlen($password) < 8) {

                    $errors[] =
                        'Nowe hasło musi mieć co najmniej 8 znaków.';
                }

                if ($password !== $password_confirm) {

                    $errors[] =
                        'Hasła nie są identyczne.';
                }
            }


            /*
             * ZAPIS
             */
            if (empty($errors)) {

                $update = array(
                    'ID'         => $user_id,
                    'first_name' => $first_name,
                    'last_name'  => $last_name,
                    'user_email' => $email,
                );

                if ($password !== '') {
                    $update['user_pass'] = $password;
                }

                $result = wp_update_user($update);

                if (is_wp_error($result)) {

                    $errors[] =
                        $result->get_error_message();

                } else {

                    $user = get_userdata($user_id);

                    echo '<div class="planszownia-konto-success">';
                    echo 'Konto zostało zaktualizowane.';
                    echo '</div>';
                }
            }


            /*
             * KOMUNIKATY BŁĘDÓW
             */
            if (!empty($errors)) {

                echo '<div class="planszownia-konto-error">';

                foreach ($errors as $error) {

                    echo '<div>';
                    echo esc_html($error);
                    echo '</div>';
                }

                echo '</div>';
            }
        }
    }


    /* =====================================================
     * FORMULARZ KONTA
     * ===================================================== */

    ?>

    <div class="planszownia-konto-tab">

        <div class="planszownia-konto-title">

            <i class="um-faicon-user"></i>

            <span>Konto</span>

        </div>


        <form
            method="post"
            class="planszownia-konto-form"
        >

            <?php

            wp_nonce_field(
                'planszownia_konto_save',
                'planszownia_konto_nonce'
            );

            ?>


            <!-- NAZWA UŻYTKOWNIKA -->

            <div class="planszownia-konto-field">

                <label>
                    Nazwa użytkownika
                </label>

                <input
                    type="text"
                    value="<?php echo esc_attr($user->user_login); ?>"
                    disabled
                >

            </div>


            <!-- IMIĘ -->

            <div class="planszownia-konto-field">

                <label>
                    Imię
                </label>

                <input
                    type="text"
                    name="first_name"
                    value="<?php echo esc_attr($user->first_name); ?>"
                >

            </div>


            <!-- NAZWISKO -->

            <div class="planszownia-konto-field">

                <label>
                    Nazwisko
                </label>

                <input
                    type="text"
                    name="last_name"
                    value="<?php echo esc_attr($user->last_name); ?>"
                >

            </div>


            <!-- EMAIL -->

            <div class="planszownia-konto-field">

                <label>
                    Email address
                </label>

                <input
                    type="email"
                    name="user_email"
                    value="<?php echo esc_attr($user->user_email); ?>"
                >

            </div>


            <!-- NOWE HASŁO -->

            <div class="planszownia-konto-field">

                <label>
                    Nowe hasło
                </label>

                <input
                    type="password"
                    name="new_password"
                    value=""
                    autocomplete="new-password"
                    placeholder="Pozostaw puste, jeśli nie zmieniasz"
                >

            </div>


            <!-- POWTÓRZ HASŁO -->

            <div class="planszownia-konto-field">

                <label>
                    Powtórz nowe hasło
                </label>

                <input
                    type="password"
                    name="new_password_confirm"
                    value=""
                    autocomplete="new-password"
                >

            </div>


            <!-- PRZYCISK -->

            <div class="planszownia-konto-button">

                <button
                    type="submit"
                    name="planszownia_konto_submit"
                    class="um-button"
                >
                    Zaktualizuj konto
                </button>

            </div>

        </form>

    </div>

    <?php
}


