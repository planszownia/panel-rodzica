/* =========================================================
   PLANSZOWNIA – PROFESJONALNY PROFIL GRACZA
   Ultimate Member
   ========================================================= */

/* GŁÓWNY PROFIL */
.um-profile {
    max-width: 1050px !important;
    margin: 35px auto 60px !important;
    background: #fff !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    box-shadow: 0 10px 35px rgba(0,0,0,.12) !important;
}

/* =========================================================
   NAGŁÓWEK PROFILU – CIEMNY PANEL
   ========================================================= */

.um-profile-header {
    background: linear-gradient(135deg, #11131c 0%, #20232e 100%) !important;
    min-height: 245px !important;
    position: relative !important;
    padding: 35px 40px 0 !important;
}

/* delikatny pomarańczowy akcent */
.um-profile-header:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 5px;
    background: #e87524;
}

/* =========================================================
   AVATAR
   ========================================================= */

.um-profile-photo {
    position: relative !important;
    z-index: 5 !important;
    padding-top: 20px !important;
    text-align: center !important;
}

.um-profile-photo img {
    width: 155px !important;
    height: 155px !important;
    object-fit: cover !important;
    border-radius: 50% !important;

    border: 7px solid #fff !important;

    box-shadow:
        0 5px 25px rgba(0,0,0,.30),
        0 0 0 4px rgba(232,117,36,.85) !important;
}

/* =========================================================
   NAZWA GRACZA
   ========================================================= */

.um-profile-name {
    text-align: center !important;
    color: #fff !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: .8px !important;
    margin-top: 12px !important;
}

/* =========================================================
   MENU PROFILU
   ========================================================= */

.um-profile-nav {
    position: relative !important;
    z-index: 10 !important;

    background: #151720 !important;

    display: flex !important;
    justify-content: center !important;
    align-items: center !important;

    gap: 8px !important;
    padding: 10px !important;

    border-radius: 0 !important;
}

/* przyciski */
.um-profile-nav-item a {
    color: #dcdde1 !important;
    background: transparent !important;

    padding: 12px 24px !important;
    border-radius: 8px !important;

    font-size: 13px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: .3px !important;

    transition: all .2s ease !important;
}

/* aktywna */
.um-profile-nav-item.active a {
    background: #e87524 !important;
    color: #fff !important;

    box-shadow: 0 3px 10px rgba(232,117,36,.30) !important;
}

/* hover */
.um-profile-nav-item a:hover {
    background: #e87524 !important;
    color: #fff !important;
}

/* =========================================================
   TREŚĆ PROFILU
   ========================================================= */

.um-profile-body {
    background: #fff !important;
    padding: 35px 55px 50px !important;
}

/* =========================================================
   INFORMACJE – KARTY
   ========================================================= */

.um-profile .um-field {
    background: #fafafa !important;

    border: 1px solid #e9e9e9 !important;
    border-left: 4px solid #e87524 !important;

    border-radius: 10px !important;

    padding: 15px 20px !important;
    margin-bottom: 12px !important;

    box-shadow: 0 2px 7px rgba(0,0,0,.035) !important;

    transition: all .2s ease !important;
}

.um-profile .um-field:hover {
    background: #fff !important;

    transform: translateX(3px);

    box-shadow: 0 5px 15px rgba(0,0,0,.07) !important;
}

/* nazwa pola */
.um-profile .um-field-label {
    color: #888 !important;

    font-size: 10px !important;
    font-weight: 800 !important;

    text-transform: uppercase !important;
    letter-spacing: .8px !important;

    margin-bottom: 5px !important;
}

/* wartość */
.um-profile .um-field-value {
    color: #20222a !important;

    font-size: 16px !important;
    font-weight: 600 !important;
}

/* =========================================================
   IKONY / ELEMENTY AKCENTOWE
   ========================================================= */

.um-profile .um-field-icon {
    color: #e87524 !important;
}

/* =========================================================
   MENU ZĘBATKI
   ========================================================= */

.um-profile .um-dropdown-trigger {
    background: #e87524 !important;
    color: #fff !important;

    width: 48px !important;
    height: 48px !important;

    border-radius: 10px !important;

    box-shadow: 0 4px 12px rgba(0,0,0,.15) !important;
}

.um-profile .um-dropdown-trigger:hover {
    background: #c95f16 !important;
}

/* rozwijane menu */
.um-profile .um-dropdown {
    border-radius: 10px !important;
    overflow: hidden !important;

    border: 1px solid #e5e5e5 !important;

    box-shadow: 0 10px 30px rgba(0,0,0,.15) !important;
}

.um-profile .um-dropdown li a {
    padding: 12px 16px !important;
    color: #333 !important;
    font-size: 13px !important;
}

.um-profile .um-dropdown li a:hover {
    background: #f7f7f7 !important;
    color: #e87524 !important;
}

/* =========================================================
   RESPONSIVE – TELEFON
   ========================================================= */

@media (max-width: 700px) {

    .um-profile {
        margin: 15px 8px 30px !important;
        border-radius: 14px !important;
    }

