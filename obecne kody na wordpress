 * ========================================================= */

add_filter(
    'um_login_redirect_url',
    'planszownia_login_redirect_um',
    9999,
    2
);

function planszownia_login_redirect_um($url, $user_id) {

    if (
        $user_id &&
        function_exists('um_user_profile_url')
    ) {

        return um_user_profile_url($user_id);
    }

    return $url;
}


/* =========================================================
 * 6. WORDPRESS LOGOWANIE → PROFIL
 * ========================================================= */

add_filter(
    'login_redirect',
    'planszownia_login_redirect_wp',
    9999,
    3
);

function planszownia_login_redirect_wp(
    $redirect_to,
    $requested_redirect_to,
    $user
) {

    if (
        $user instanceof WP_User &&
        $user->exists() &&
        function_exists('um_user_profile_url')
    ) {

        return um_user_profile_url($user->ID);
    }

    return $redirect_to;
}
