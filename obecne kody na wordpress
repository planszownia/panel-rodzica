/**
 * PLANSZOWNIA
 * PROFIL UŻYTKOWNIKA
 *
 * WIADOMOŚCI → RODZIC → KONTO
 */


/* =========================================================
 * 1. ZAKŁADKI PROFILU
 * ========================================================= */

add_filter(
    'um_profile_tabs',
    'planszownia_profile_tabs',
    1000
);

function planszownia_profile_tabs($tabs) {

    /*
     * Usuwamy stare/dodatkowe zakładki.
     */
    unset($tabs['gry']);
    unset($tabs['wyniki']);
    unset($tabs['turnieje']);
    unset($tabs['konto']);
    unset($tabs['rodzic']);

    /*
     * Usuwamy standardowe Wpisy i Komentarze.
     */
    unset($tabs['posts']);
    unset($tabs['comments']);

    /*
     * RODZIC
     */
    $tabs['rodzic'] = array(
        'name'            => 'Rodzic',
        'icon'            => 'um-faicon-users',
        'custom'          => true,
        'default_privacy' => 3,
    );

    /*
     * KONTO
     */
    $tabs['konto'] = array(
        'name'            => 'Konto',
        'icon'            => 'um-faicon-user',
        'custom'          => true,
        'default_privacy' => 3,
    );

    /*
     * KOŃCOWA KOLEJNOŚĆ:
     *
     * WIADOMOŚCI
     * RODZIC
     * KONTO
     */

    $ordered = array();

    /*
     * WIADOMOŚCI
     */
    if (isset($tabs['messages'])) {
        $ordered['messages'] = $tabs['messages'];
    }

    /*
     * Jeżeli UM ma inną nazwę klucza dla Wiadomości,
     * szukamy jej po nazwie.
     */
    if (!isset($ordered['messages'])) {

        foreach ($tabs as $key => $tab) {

            if (
                isset($tab['name']) &&
                strtolower(wp_strip_all_tags($tab['name'])) === 'wiadomości'
            ) {

                $ordered[$key] = $tab;
                break;
            }
        }
    }

    /*
     * RODZIC
     */
    if (isset($tabs['rodzic'])) {
        $ordered['rodzic'] = $tabs['rodzic'];
    }

    /*
     * KONTO
     */
    if (isset($tabs['konto'])) {
        $ordered['konto'] = $tabs['konto'];
    }

    /*
     * Zwracamy tylko nasze trzy zakładki.
     */
    return $ordered;
}


/* =========================================================
 * 2. ZAKŁADKA RODZIC
 * ========================================================= */

