 * ============================================================ */

function pw152_loan_history_install() {

    global $wpdb;

    $table = $wpdb->prefix . 'pw_loan_messages';

    require_once ABSPATH . 'wp-admin/includes/upgrade.php';

    $charset = $wpdb->get_charset_collate();

    $sql = "CREATE TABLE {$table} (
        id bigint unsigned NOT NULL AUTO_INCREMENT,
        loan_id bigint unsigned NOT NULL,
        admin_user_id bigint unsigned NOT NULL,
        message text NOT NULL,
        message_type varchar(30) NOT NULL DEFAULT 'message',
        created_at datetime NOT NULL,
        PRIMARY KEY  (id),
        KEY loan_id (loan_id),
        KEY created_at (created_at)
    ) {$charset};";

    dbDelta($sql);
}

add_action('init', 'pw152_loan_history_install');


/* ============================================================
 * 2. ZAPIS WIADOMOŚCI
 * ============================================================ */

function pw152_loan_history_add(
    $loan_id,
    $message,
    $type = 'message'
) {

    global $wpdb;

    $message = trim((string) $message);

    if ($message === '') {
        return;
    }

    $table = $wpdb->prefix . 'pw_loan_messages';

    $wpdb->insert(
        $table,
        array(
            'loan_id'       => absint($loan_id),
            'admin_user_id' => get_current_user_id(),
            'message'       => $message,
            'message_type'  => sanitize_key($type),
            'created_at'    => current_time('mysql'),
        ),
        array(
            '%d',
            '%d',
            '%s',
            '%s',
            '%s',
        )
    );
}


/* ============================================================
 * 3. WSPÓLNE SPRAWDZENIE WYPOŻYCZENIA
 * ============================================================ */

function pw152_get_loan($loan_id) {

    global $wpdb;

    $table = $wpdb->prefix . 'pw_loans';

    return $wpdb->get_row(
        $wpdb->prepare(
            "SELECT * FROM {$table} WHERE id = %d LIMIT 1",
            absint($loan_id)
        )
    );
}


