                        '"]'
                    );
            }

            if (!textarea) {
                alert('Nie znaleziono pola wiadomości.');
                return;
            }

            const message =
                textarea.value.trim();

            if (!message) {
                alert(
                    'Wpisz wiadomość przed wysłaniem.'
                );
                textarea.focus();
                return;
            }

            if (!confirm(
                'Czy wysłać tę wiadomość do gracza?'
            )) {
                return;
            }

            const original =
                button.textContent;

            button.disabled = true;
            button.textContent = 'Wysyłanie…';


            pwLoanRequest({

                action: 'pw_loan_message',

                loan: loan,

                message: message,

                nonce:
                    window.PWGracz
