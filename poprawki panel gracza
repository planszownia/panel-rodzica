                        'Nie udało się wysłać wiadomości.'
                    );
                }

                textarea.value = '';

                alert(
                    result.data &&
                    result.data.message
                        ? result.data.message
                        : 'Wiadomość została wysłana.'
                );

                button.disabled = false;
                button.textContent = original;

            })
            .catch(function (error) {

                alert(error.message);

                button.disabled = false;
                button.textContent = original;
            });

        }, true);

