 * ============================================================ */

add_action(
    'wp_ajax_pw152_loan_action',
    function () {

        if (
            !is_user_logged_in() ||
            !current_user_can('manage_options')
        ) {
            wp_send_json_error(
                'Brak uprawnień.'
            );
        }

        if (
            empty($_POST['nonce']) ||
            !wp_verify_nonce(
                sanitize_text_field(
                    wp_unslash($_POST['nonce'])
                ),
                'pw_gracz'
            )
        ) {
            wp_send_json_error(
                'Błąd zabezpieczenia.'
            );
        }

        $loan_id = absint(
            $_POST['loan'] ?? 0
        );

        $action = sanitize_key(
            $_POST['loan_action'] ?? ''
        );

        $message = sanitize_textarea_field(
            wp_unslash(
                $_POST['message'] ?? ''
            )
        );

        $loan = pw152_get_loan($loan_id);

        if (!$loan) {
            wp_send_json_error(
                'Nie znaleziono wypożyczenia.'
            );
        }

        global $wpdb;

        $table = $wpdb->prefix . 'pw_loans';

        /* -----------------------------------------
         * ZATWIERDZENIE
         * ----------------------------------------- */

        if ($action === 'approve') {

            if ($loan->status !== 'requested') {
                wp_send_json_error(
                    'To wypożyczenie nie oczekuje już na decyzję.'
                );
            }

            $wpdb->update(
                $table,
                array(
                    'status'        => 'borrowed',
                    'approved_at'   => current_time('mysql'),
                    'decision_note' =>
                        $message,
                ),
                array(
                    'id' => $loan_id,
                ),
                array(
                    '%s',
                    '%s',
                    '%s',
                ),
                array('%d')
            );

            if ($message !== '') {

                pw152_loan_history_add(
                    $loan_id,
                    $message,
                    'approval'
                );
            }

            wp_send_json_success(
                array(
                    'message' =>
                        'Wypożyczenie zostało zatwierdzone.',
                )
            );
        }


        /* -----------------------------------------
         * ODRZUCENIE
         * ----------------------------------------- */

        if ($action === 'reject') {

            if ($loan->status !== 'requested') {
                wp_send_json_error(
                    'Ta prośba nie oczekuje już na decyzję.'
                );
            }

            $wpdb->update(
                $table,
                array(
                    'status' => 'rejected',
                    'decision_note' =>
                        $message,
                ),
                array(
                    'id' => $loan_id,
                ),
                array(
                    '%s',
                    '%s',
                ),
                array('%d')
            );

            if ($message !== '') {

                pw152_loan_history_add(
                    $loan_id,
                    $message,
                    'rejection'
                );
            }

            wp_send_json_success(
                array(
                    'message' =>
                        'Prośba została odrzucona.',
                )
            );
        }


        /* -----------------------------------------
         * PROŚBA O ZWROT
         * ----------------------------------------- */

        if ($action === 'ask_return') {

            if ($loan->status !== 'borrowed') {
                wp_send_json_error(
                    'Ta gra nie jest obecnie wypożyczona.'
                );
            }

            $wpdb->update(
                $table,
                array(
                    'status' => 'return_requested',
                    'decision_note' =>
                        $message,
                ),
                array(
                    'id' => $loan_id,
                ),
                array(
                    '%s',
                    '%s',
                ),
                array('%d')
            );

            if ($message !== '') {

                pw152_loan_history_add(
                    $loan_id,
                    $message,
                    'return_request'
                );
            }

            wp_send_json_success(
                array(
                    'message' =>
                        'Prośba o zwrot została wysłana.',
                )
            );
        }


        /* -----------------------------------------
         * POTWIERDZENIE ZWROTU
         * ----------------------------------------- */

        if ($action === 'return') {

            if (
                $loan->status !== 'borrowed' &&
                $loan->status !== 'return_requested'
            ) {
                wp_send_json_error(
                    'To wypożyczenie nie jest aktywne.'
                );
            }

            $wpdb->update(
                $table,
                array(
                    'status'     => 'returned',
                    'returned_at' =>
                        current_time('mysql'),
                ),
                array(
                    'id' => $loan_id,
                ),
                array(
                    '%s',
                    '%s',
                ),
                array('%d')
            );

            wp_send_json_success(
                array(
                    'message' =>
                        'Zwrot gry został potwierdzony. Gra jest ponownie dostępna.',
                )
            );
        }


        wp_send_json_error(
            'Nieznana operacja.'
        );
    }
);


