 */

add_action('wp_footer', function () {

    if (!is_user_logged_in()) {
        return;
    }

    ?>
    <script>
    (function () {

        document.addEventListener('click', function (e) {

            const button = e.target.closest('.pw-loan-cancel');

            if (!button) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            const loan = parseInt(
                button.getAttribute('data-loan'),
                10
            );

            if (!loan) {
                alert('Nie znaleziono zgłoszenia.');
                return;
            }

            if (!window.PWGraczLoanAjax) {
                alert('Nie udało się połączyć z modułem wypożyczeń.');
                return;
            }

            if (!confirm(
                'Czy na pewno chcesz anulować prośbę o wypożyczenie?'
            )) {
                return;
            }

            const originalText = button.textContent;

            button.disabled = true;
            button.textContent = 'Anulowanie…';

            window.PWGraczLoanAjax({
                action: 'pw_cancel_loan',
                loan: loan
            })
            .done(function (result) {

                if (result && result.success) {

                    /*
                     * Jeżeli przycisk znajduje się przy karcie gry,
                     * natychmiast pokazujemy ponownie możliwość
                     * wypożyczenia.
                     */
                    const box =
                        button.closest('.pw-loan-box');

                    if (box) {

                        const game =
                            box.getAttribute('data-game') ||
                            button.getAttribute('data-game');

                        if (game) {

                            box.innerHTML =
                                '<span class="pw-loan-status pw-loan-available">' +
                                    '<i></i> Dostępna w klubie' +
                                '</span>' +
                                '<button type="button" ' +
                                    'class="pw-loan-request" ' +
                                    'data-game="' +
                                        parseInt(game, 10) +
                                    '">' +
                                    '📦 Chcę wypożyczyć' +
                                '</button>';
                        }
                    }

                    /*
                     * Odświeżamy „Moje wypożyczenia”.
                     */
                    if (
                        typeof window.pwRefreshLoanStatuses ===
                        'function'
                    ) {
                        window.pwRefreshLoanStatuses();
                    }

                    /*
                     * Jeżeli jesteśmy w panelu „Moje wypożyczenia”,
                     * odświeżamy go bez opuszczania profilu.
                     */
                    if (
                        typeof window.pwRefreshPanel ===
                        'function'
                    ) {
                        window.pwRefreshPanel(
                            'moje-wypozyczenia'
                        );
                    }

                    if (
                        result.data &&
                        result.data.message
                    ) {
                        if (typeof window.pwToast === 'function') {
                            window.pwToast(
                                result.data.message
                            );
                        }
                    }

                } else {

                    alert(
                        result && result.data
                            ? result.data
                            : 'Nie udało się anulować prośby.'
                    );

                    button.disabled = false;
                    button.textContent = originalText;
                }

            })
            .fail(function (xhr) {

                let message =
                    'Błąd połączenia z serwerem.';

                try {
                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.data
                    ) {
                        message =
                            xhr.responseJSON.data;
                    }
                } catch (error) {}

                alert(message);

                button.disabled = false;
                button.textContent = originalText;
            });

        }, true);

    })();
    </script>
    <?php
});
/**
 * Planszownia Gracz 1.5.2
 * Pełna obsługa przycisków wypożyczalni:
 *
 * - Anuluj prośbę
 * - Wyślij wiadomość
 * - Zatwierdź
 * - Odrzuć
 * - Poproś o zwrot
 * - Potwierdź zwrot
 *
 * Nie ingeruje w Strefę Rodzica.
 */

add_action('wp_footer', function () {

    if (!is_user_logged_in()) {
        return;
    }

    ?>
    <script>
    (function () {

        /*
         * Uniwersalne wysłanie AJAX do istniejącego
         * mechanizmu Planszownia Gracz 1.5.2.
         */
        function pwLoanRequest(data) {

            return fetch(
                window.PWGracz && PWGracz.ajax
                    ? PWGracz.ajax
                    : '<?php echo esc_url(admin_url('admin-ajax.php')); ?>',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type':
                            'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: new URLSearchParams(data).toString()
                }
            ).then(function (response) {
                return response.json();
            });
        }


        /*
         * =========================================================
         * GRACZ — ANULUJ PROŚBĘ
         * =========================================================
         */

        document.addEventListener('click', function (e) {

            const button =
                e.target.closest('.pw-loan-cancel');

            if (!button) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            const loan =
                parseInt(
                    button.getAttribute('data-loan'),
                    10
                );

            if (!loan) {
                alert('Nie znaleziono wypożyczenia.');
                return;
            }

            if (!confirm(
                'Czy na pewno chcesz anulować prośbę o wypożyczenie?'
            )) {
                return;
            }

            const original =
                button.textContent;

            button.disabled = true;
            button.textContent = 'Anulowanie…';

            pwLoanRequest({
                action: 'pw_cancel_loan',
                loan: loan,
                nonce:
                    window.PWGracz
                        ? PWGracz.nonce
                        : ''
            })
            .then(function (result) {

                if (!result.success) {

                    throw new Error(
                        result.data ||
                        'Nie udało się anulować prośby.'
                    );
                }

                /*
                 * Odświeżamy stronę/panel.
                 * Dzięki temu gra ponownie pokaże
                 * możliwość wypożyczenia.
                 */
                window.location.reload();

            })
            .catch(function (error) {

                alert(error.message);

                button.disabled = false;
                button.textContent = original;
            });

        }, true);


        /*
         * =========================================================
         * ADMIN — ZATWIERDŹ / ODRZUĆ / POPROŚ O ZWROT /
         *         POTWIERDŹ ZWROT
         * =========================================================
         */

        document.addEventListener('click', function (e) {

            const button =
                e.target.closest('.pw-admin-loan');

            if (!button) {
                return;
            }

            const action =
                button.getAttribute('data-do');

            /*
             * Obsługujemy wszystkie cztery akcje tutaj.
             */
            if (
                action !== 'approve' &&
                action !== 'reject' &&
                action !== 'ask_return' &&
                action !== 'return'
            ) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            const loan =
                parseInt(
                    button.getAttribute('data-loan'),
                    10
                );

            if (!loan) {
                alert('Nie znaleziono wypożyczenia.');
                return;
            }

            let message = '';

            /*
             * -----------------------------------------------------
             * ZATWIERDZENIE
             * -----------------------------------------------------
             */

            if (action === 'approve') {

                message = window.prompt(
                    'Wiadomość dla gracza po zatwierdzeniu wypożyczenia (opcjonalnie):',
                    ''
                );

                if (message === null) {
                    return;
                }
            }


            /*
             * -----------------------------------------------------
             * ODRZUCENIE
             * -----------------------------------------------------
             */

            if (action === 'reject') {

                message = window.prompt(
                    'Powód / wiadomość dla gracza (opcjonalnie):',
                    ''
                );

                if (message === null) {
                    return;
                }
            }


            /*
             * -----------------------------------------------------
             * PROŚBA O ZWROT
             * -----------------------------------------------------
             */

            if (action === 'ask_return') {

                message = window.prompt(
                    'Wiadomość z prośbą o zwrot gry (opcjonalnie):',
                    'Przypominamy o zwrocie wypożyczonej gry. Prosimy o jej zwrot do Planszowni.'
                );

                if (message === null) {
                    return;
                }
            }


            /*
             * -----------------------------------------------------
             * POTWIERDZENIE ZWROTU
             * -----------------------------------------------------
             */

            if (action === 'return') {

                if (!confirm(
                    'Czy potwierdzasz, że gra została zwrócona do Planszowni?'
                )) {
                    return;
                }
            }


            /*
             * Potwierdzenie wykonania operacji.
             */
            let confirmation = '';

            if (action === 'approve') {
                confirmation =
                    'Czy zatwierdzić to wypożyczenie?';

            } else if (action === 'reject') {
                confirmation =
                    'Czy odrzucić tę prośbę?';

            } else if (action === 'ask_return') {
                confirmation =
                    'Czy wysłać graczowi prośbę o zwrot gry?';

            } else if (action === 'return') {
                confirmation =
                    'Czy potwierdzasz zwrot gry?';
            }

            if (
                confirmation &&
                !confirm(confirmation)
            ) {
                return;
            }


            const original =
                button.textContent;

            button.disabled = true;
            button.textContent = 'Zapisywanie…';


            /*
             * Wysyłamy do istniejącego AJAX-a 1.5.2.
             */
            pwLoanRequest({

                action: 'pw_loan_action',

                loan: loan,

                'do': action,

                message: message,

                reason: message,

                nonce:
                    window.PWGracz
                        ? PWGracz.nonce
                        : ''

            })
            .then(function (result) {

                if (!result.success) {

                    throw new Error(
                        result.data ||
                        'Nie udało się wykonać operacji.'
                    );
                }

                /*
                 * Sukces.
                 *
                 * Odświeżamy panel wypożyczalni.
                 */
                window.location.reload();

            })
            .catch(function (error) {

                alert(error.message);

                button.disabled = false;
                button.textContent = original;
            });

        }, true);


        /*
         * =========================================================
         * ADMIN — WYŚLIJ WIADOMOŚĆ
         * =========================================================
         *
         * Obsługujemy kilka możliwych nazw klas przycisku,
         * żeby pasowało do obecnego panelu 1.5.2.
         */

        document.addEventListener('click', function (e) {

            const button =
                e.target.closest(
                    '.pw-loan-message-send, .pw-admin-loan-message, [data-loan-message-send]'
                );

            if (!button) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            let loan =
                parseInt(
                    button.getAttribute('data-loan'),
                    10
                );

            /*
             * Jeżeli przycisk nie ma data-loan,
             * szukamy go w najbliższej karcie wypożyczenia.
             */
            const card =
                button.closest(
                    '.pw-loan-card, .pw-loan-item, .pw-admin-loan-card'
                );

            if (!loan && card) {

                loan =
                    parseInt(
                        card.getAttribute('data-loan'),
                        10
                    );
            }

            if (!loan) {
                alert('Nie znaleziono wypożyczenia.');
                return;
            }

            /*
             * Szukamy pola wiadomości.
             */
            let textarea = null;

            if (card) {
                textarea =
                    card.querySelector(
                        'textarea[name="message"], textarea.pw-loan-message, textarea'
                    );
            }

            if (!textarea) {
                textarea =
                    document.querySelector(
                        'textarea[data-loan="' +
