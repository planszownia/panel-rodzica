/**
 * Planszownia Gracz 1.5.2
 * Wyczyść tylko zsynchronizowaną kolekcję BGG użytkownika.
 */

add_action('wp_ajax_pw_clear_bgg_collection', function () {

    if (!is_user_logged_in()) {
        wp_send_json_error('Musisz być zalogowany.');
    }

    if (
        empty($_POST['nonce']) ||
        !wp_verify_nonce(
            sanitize_text_field(wp_unslash($_POST['nonce'])),
            'pw_gracz'
        )
    ) {
        wp_send_json_error('Błąd zabezpieczenia. Odśwież stronę.');
    }

    global $wpdb;

    $table   = $wpdb->prefix . 'pw_player_games';
    $user_id = get_current_user_id();

    /*
     * Usuwamy WYŁĄCZNIE:
     * - aktualnego użytkownika
     * - rekordy pochodzące z synchronizacji BGG
     *
     * Nie usuwamy niczego z pw_games.
     */
    $deleted = $wpdb->query(
        $wpdb->prepare(
            "DELETE FROM {$table}
             WHERE user_id = %d
             AND is_bgg_sync = 1",
            $user_id
        )
    );

    if ($deleted === false) {
        wp_send_json_error('Nie udało się wyczyścić kolekcji BGG.');
    }

    wp_send_json_success([
        'message' => 'Zsynchronizowana kolekcja BGG została wyczyszczona.',
        'deleted' => (int) $deleted
    ]);
});


/**
 * Dodaje przycisk do „Moja biblioteka”.
 * Przycisk pojawia się tylko na własnym profilu.
 */
add_action('wp_footer', function () {

    if (!is_user_logged_in()) {
        return;
    }

    ?>
    <script>
    (function () {

        function addBGGClearButton() {

            const panel = document.querySelector(
                '[data-pw-panel="moja"]'
            );

            if (!panel) {
                return;
            }

            /*
             * Jeżeli nie ma pola nazwy BGG,
             * oglądamy cudzy profil — nic nie dodajemy.
             */
            if (!panel.querySelector('#pw-bgg-username')) {
                return;
            }

            /*
             * Nie dodawaj przycisku drugi raz.
             */
            if (panel.querySelector('#pw-clear-bgg-collection-box')) {
                return;
            }

            const card = panel.querySelector('.pw-card');

            if (!card) {
                return;
            }

            const box = document.createElement('div');

            box.id = 'pw-clear-bgg-collection-box';
            box.style.marginTop = '16px';
            box.style.paddingTop = '12px';
            box.style.borderTop = '1px solid rgba(0,0,0,.08)';

            box.innerHTML = `
                <button
                    type="button"
                    class="pw-btn pw-btn-light"
                    id="pw-clear-bgg-collection">
                    🗑️ Wyczyść zsynchronizowaną kolekcję BGG
                </button>

                <span
                    id="pw-clear-bgg-msg"
                    class="pw-msg"
                    style="margin-left:10px;">
                </span>
            `;

            card.appendChild(box);

            const button = box.querySelector(
                '#pw-clear-bgg-collection'
            );

            button.addEventListener('click', function () {

                const confirmed = window.confirm(
                    'Czy na pewno chcesz wyczyścić zsynchronizowaną kolekcję BGG?\\n\\n' +
                    'Usunięte zostaną tylko gry pobrane przez synchronizację BGG.\\n\\n' +
                    'Biblioteka Planszowni, kolekcje innych graczy oraz gry dodane ręcznie pozostaną bez zmian.'
                );

                if (!confirmed) {
                    return;
                }

                button.disabled = true;
                button.textContent = 'Czyszczenie...';

                const data = new URLSearchParams();

                data.append(
                    'action',
                    'pw_clear_bgg_collection'
                );

                data.append(
                    'nonce',
                    window.PWGracz && PWGracz.nonce
                        ? PWGracz.nonce
                        : ''
                );

                fetch(
                    window.PWGracz && PWGracz.ajax
                        ? PWGracz.ajax
                        : '<?php echo esc_url(admin_url('admin-ajax.php')); ?>',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: data.toString()
                    }
                )
                .then(function (response) {
                    return response.json();
                })
                .then(function (result) {

                    if (result.success) {

                        const deleted =
                            result.data && result.data.deleted
                                ? result.data.deleted
                                : 0;

                        const msg =
                            document.querySelector(
                                '#pw-clear-bgg-msg'
                            );

                        if (msg) {
                            msg.textContent =
                                '✓ Usunięto ' + deleted + ' gier.';
                            msg.classList.add('is-ok');
                        }

                        /*
                         * Odświeżamy tylko panel „Moja biblioteka”.
                         */
                        if (
                            typeof window.pwRefreshPanel ===
                            'function'
                        ) {
                            window.pwRefreshPanel('moja');
                        } else {
                            window.location.reload();
                        }

                    } else {

                        alert(
                            result.data ||
                            'Nie udało się wyczyścić kolekcji BGG.'
                        );

                        button.disabled = false;
                        button.textContent =
                            '🗑️ Wyczyść zsynchronizowaną kolekcję BGG';
                    }

                })
                .catch(function () {

                    alert(
                        'Wystąpił błąd połączenia. Spróbuj ponownie.'
                    );

                    button.disabled = false;
                    button.textContent =
                        '🗑️ Wyczyść zsynchronizowaną kolekcję BGG';
                });
            });
        }


        /*
         * Panel „Moja biblioteka” jest odświeżany AJAX-em,
         * dlatego obserwujemy zmiany i w razie potrzeby
         * ponownie dodajemy przycisk.
         */
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                addBGGClearButton();

                const observer =
                    new MutationObserver(function () {
                        addBGGClearButton();
                    });

                observer.observe(
                    document.body,
                    {
                        childList: true,
                        subtree: true
                    }
                );
            }
        );

    })();
    </script>
    <?php
});
