                        '✉ Wyślij';
                });

            },
            true
        );


        /* ========================================================
         * HISTORIA DLA ADMINISTRATORA
         * ======================================================== */

        function pw152FindLoanPanel() {

            const firstButton =
                document.querySelector(
                    '.pw-admin-loan'
                );

            if (!firstButton) {
                return null;
            }

            let node =
                firstButton;

            for (
                let i = 0;
                i < 8 && node;
                i++
            ) {

                if (
                    node.querySelector &&
                    node.querySelector(
                        '.pw-admin-loan'
                    ) &&
                    node.textContent
                        .toUpperCase()
                        .indexOf('WYPOŻYCZENIA') !== -1
                ) {
                    return node;
                }

                node =
                    node.parentElement;
            }

            return (
                firstButton.closest(
                    '[data-pw-panel]'
                ) ||
                firstButton.parentElement
            );
        }


        function pw152LoadHistory() {

            if (
                !window.PWGracz ||
                !PWGracz.ajax
            ) {
                return;
            }

            pw152Ajax({
                action:
                    'pw152_loan_history'
            })
            .then(function (result) {

                if (
                    !result.success ||
                    !result.data ||
                    !result.data.html
                ) {
                    return;
                }

                const panel =
                    pw152FindLoanPanel();

                if (!panel) {
                    return;
                }

                let history =
                    document.querySelector(
                        '#pw152-admin-loan-history'
                    );

                if (history) {
                    history.remove();
                }

                panel.insertAdjacentHTML(
                    'beforeend',
                    result.data.html
                );
            });
        }


        document.addEventListener(
            'DOMContentLoaded',
            function () {

                setTimeout(
                    pw152LoadHistory,
                    500
                );

                /*
                 * Panel Gracza jest odświeżany AJAX-em,
                 * więc próbujemy ponownie po zmianach DOM.
                 */
                const observer =
                    new MutationObserver(
                        function () {

                            if (
                                !document.querySelector(
                                    '#pw152-admin-loan-history'
                                )
                            ) {
                                setTimeout(
                                    pw152LoadHistory,
                                    300
                                );
                            }
                        }
                    );

                observer.observe(
                    document.body,
                    {
                        childList: true,
                        subtree: true
                    }
                );
            }
        );

    })();
    </script>

