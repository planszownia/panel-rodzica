add_action('wp_ajax_pw152_reject_loan', function () {

    if (
        !is_user_logged_in() ||
        !current_user_can('manage_options')
    ) {
        wp_send_json_error(
            'Brak uprawnień.'
        );
    }

    if (
        empty($_POST['nonce']) ||
        !wp_verify_nonce(
            sanitize_text_field(
                wp_unslash($_POST['nonce'])
            ),
            'pw_gracz'
        )
    ) {
        wp_send_json_error(
            'Błąd zabezpieczenia.'
        );
    }

    global $wpdb;

    $loan_id = absint(
        $_POST['loan'] ?? 0
    );

    $message = sanitize_textarea_field(
        wp_unslash(
            $_POST['message'] ?? ''
        )
    );

    if (!$loan_id) {
        wp_send_json_error(
            'Nie znaleziono wypożyczenia.'
        );
    }

    $loans_table =
        $wpdb->prefix . 'pw_loans';

    $loan = $wpdb->get_row(
        $wpdb->prepare(
            "
            SELECT *
            FROM {$loans_table}
            WHERE id = %d
            LIMIT 1
            ",
            $loan_id
        )
    );

    if (!$loan) {
        wp_send_json_error(
            'Wypożyczenie nie istnieje.'
        );
    }

    if ($loan->status !== 'requested') {
        wp_send_json_error(
            'Ta prośba nie oczekuje już na decyzję.'
        );
    }

    /*
     * Najpierw zmieniamy status.
     */
    $updated = $wpdb->update(
        $loans_table,
        array(
            'status' => 'rejected',
            'decision_note' => $message,
        ),
        array(
            'id' => $loan_id,
        ),
        array(
            '%s',
            '%s',
        ),
        array(
            '%d',
        )
    );

    if ($updated === false) {
        wp_send_json_error(
            'Nie udało się zapisać odrzucenia.'
        );
    }

    /*
     * Wiadomość zapisujemy do historii,
     * ale tylko jeżeli administrator coś wpisał.
     */
    if ($message !== '') {

        if (
            function_exists(
                'pw152_loan_history_add'
            )
        ) {

            pw152_loan_history_add(
                $loan_id,
                $message,
                'rejection'
            );
        }
    }

    wp_send_json_success(
        array(
            'message' =>
                'Prośba została odrzucona.',
        )
    );
});


