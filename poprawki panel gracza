/**
 * Planszownia Gracz 1.5.2
 * Jednorazowe czyszczenie MOJEJ kolekcji gier
 * Nie usuwa gier z biblioteki Planszowni ani innych użytkowników.
 */

add_action('admin_post_pw_clear_my_game_collection', function () {

    // Tylko administrator
    if (!is_user_logged_in() || !current_user_can('manage_options')) {
        wp_die('Brak uprawnień.');
    }

    // Zabezpieczenie
    if (
        !isset($_POST['pw_clear_collection_nonce']) ||
        !wp_verify_nonce(
            $_POST['pw_clear_collection_nonce'],
            'pw_clear_my_game_collection'
        )
    ) {
        wp_die('Nieprawidłowe zabezpieczenie.');
    }

    global $wpdb;

    $table = $wpdb->prefix . 'pw_player_games';
    $user_id = get_current_user_id();

    // USUWAMY TYLKO POWIĄZANIA GIER Z TWOJĄ KOLEKCJĄ
    $deleted = $wpdb->delete(
        $table,
        array(
            'user_id' => $user_id
        ),
        array('%d')
    );

    // Powrót do panelu administracyjnego
    $redirect = wp_get_referer();

    if (!$redirect) {
        $redirect = admin_url();
    }

    $redirect = add_query_arg(
        'pw_collection_cleared',
        (int) $deleted,
        $redirect
    );

    wp_safe_redirect($redirect);
    exit;
});


